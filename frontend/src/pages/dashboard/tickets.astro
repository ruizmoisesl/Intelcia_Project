---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import FlashMessage from "../../components/FlashMessage.astro";
import TaskPriorityBadge from "../../components/TaskPriorityBadge.astro";
import TaskStatusBadge from "../../components/TaskStatusBadge.astro";
import {
  fetchGlobalTickets, fetchMyTickets, fetchTicket, fetchTicketStats,
  type Ticket, type TicketDetail, type TicketList, type TicketStats,
} from "../../services/api";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login");
const token = Astro.locals.token ?? "";

const scope = Astro.url.searchParams.get("scope") === "mine" ? "mine" : "all";
const keyParam = Astro.url.searchParams.get("key") ?? "";
const selectedKey = /^[A-Za-z][A-Za-z0-9]*-\d+$/.test(keyParam) ? keyParam : null;

// Paginación
const PAGE_SIZE = 15;
const pageParam = Number(Astro.url.searchParams.get("page") ?? "1");
const page = Number.isInteger(pageParam) && pageParam >= 1 ? pageParam : 1;

let mine: TicketList;
let global: TicketList;
try {
  [mine, global] = await Promise.all([fetchMyTickets(token), fetchGlobalTickets(token)]);
} catch {
  return Astro.redirect("/login");
}

// KPIs y detalle fallan suave: no tumban la página.
const stats: TicketStats | null = await fetchTicketStats(token).catch(() => null);
const detail: TicketDetail | null = selectedKey
  ? await fetchTicket(token, selectedKey).catch(() => null)
  : null;
type TicketComment = TicketDetail["comments"][number];
type TicketAttachment = TicketDetail["attachments"][number];

const current = scope === "mine" ? mine : global;
const allVisible: Ticket[] = current.items;

// Paginación de la lista
const totalPages = Math.max(1, Math.ceil(allVisible.length / PAGE_SIZE));
const safePage = Math.min(page, totalPages);
const startIndex = (safePage - 1) * PAGE_SIZE;
const visible = allVisible.slice(startIndex, startIndex + PAGE_SIZE);
const hasPrev = safePage > 1;
const hasNext = safePage < totalPages;

const broken = current.provider !== "jira";
const openCount = stats && stats.open_count !== null
  ? stats.open_count
  : current.provider === "jira" ? current.total : null;

const STATUS_MAP: Record<string, string> = { TODO: "PENDING", IN_PROGRESS: "IN_PROGRESS", DONE: "DONE" };
const PRIORITY_MAP: Record<string, string> = {
  Highest: "URGENT", High: "HIGH", Medium: "MEDIUM", Low: "LOW", Lowest: "LOW",
};
const statusKey = (t: { status_category: string }) => STATUS_MAP[t.status_category] ?? "PENDING";
const priorityKey = (t: { priority: string }) => PRIORITY_MAP[t.priority] ?? "MEDIUM";

const providerMessages: Record<string, string> = {
  unconfigured: "Jira no está configurado (JIRA_TICKETS_PROJECT / credenciales en backend/.env).",
  unavailable: "Jira no está disponible ahora mismo: se reintentará en la próxima consulta.",
};

const statCards = [
  { label: "Abiertos", value: openCount, suffix: "", danger: false,
    hint: current.scope_label ? `ámbito: ${current.scope_label}` : "proyecto completo" },
  { label: "Riesgo SLA", value: stats?.sla_risk ?? null, suffix: "", danger: (stats?.sla_risk ?? 0) > 0,
    hint: stats && !stats.sla_configured ? "SLA no configurado" : "próximos a vencer" },
  { label: "MTTR promedio", value: stats?.mttr_hours ?? null, suffix: " h", danger: false,
    hint: stats ? `últimos ${stats.window_days} días` : "—" },
  { label: "Satisfacción", value: stats?.satisfaction_pct ?? null, suffix: " %", danger: false,
    hint: stats && stats.rated_count > 0 ? `${stats.rated_count} valoraciones` : "sin datos" },
];

const tabClass = (active: boolean) =>
  `inline-flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-medium transition-all duration-300 ${
    active
      ? "bg-gradient-to-r from-rose-500 to-rose-600 text-white shadow-lg shadow-rose-500/25"
      : "bg-white/5 text-gray-400 hover:bg-white/10 hover:text-white border border-white/5"
  }`;

const listHref = (ticket: Ticket, targetPage = safePage) => 
  `/dashboard/tickets?scope=${scope}&key=${ticket.key}&page=${targetPage}`;

const pageHref = (targetPage: number) => 
  `/dashboard/tickets?scope=${scope}${selectedKey ? `&key=${selectedKey}` : ""}&page=${targetPage}`;
---

<DashboardLayout title="Tickets" user={user}>
  <div class="space-y-8">
    {/* Encabezado estilo Nexus */}
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <h1 class="text-3xl font-bold text-white tracking-tight flex items-center gap-3">
          <span>Mesa de ayuda</span>
          <span class="text-sm font-normal text-gray-500 tracking-normal bg-white/5 px-3 py-1 rounded-full border border-white/5">
            {global.total} abiertos
          </span>
        </h1>
        <div class="mt-2 flex flex-wrap items-center gap-2.5">
          <span class="text-xs text-gray-500">
            {mine.total} asignados a ti
          </span>
          {current.scope_label && (
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-[10px] font-medium text-emerald-400 border border-emerald-500/20">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              {current.scope_label}
            </span>
          )}
          <span class:list={[
            "inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[10px] font-medium border",
            broken
              ? "bg-amber-500/10 text-amber-400 border-amber-500/20"
              : "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
          ]}>
            <span class:list={["h-1.5 w-1.5 rounded-full", broken ? "bg-amber-400" : "bg-emerald-400"]}></span>
            {broken ? "Sin sincronizar" : "Jira · sincronizado (caché 60s)"}
          </span>
        </div>
      </div>
      <div class="flex gap-2">
        <a href="/dashboard/tickets?scope=all" class={tabClass(scope === "all")}>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          Mesón completo
        </a>
        <a href="/dashboard/tickets?scope=mine" class={tabClass(scope === "mine")}>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          Mis tickets
        </a>
      </div>
    </div>

    {/* KPIs */}
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {statCards.map((card) => (
        <div class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl p-5 hover:bg-white/10 hover:border-rose-500/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-rose-500/5">
          <div class="flex items-center justify-between mb-3">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">{card.label}</p>
            {card.danger && card.value !== null && card.value !== undefined && card.value > 0 && (
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
            )}
          </div>
          <p class:list={[
            "text-2xl font-bold tabular-nums",
            card.danger && card.value !== null && card.value !== undefined && card.value > 0
              ? "text-amber-400" 
              : "text-white",
          ]}>
            {card.value === null || card.value === undefined ? "—" : `${card.value}${card.suffix}`}
          </p>
          <p class="mt-1 text-[10px] text-gray-500">{card.hint}</p>
        </div>
      ))}
    </div>

    <FlashMessage />

    {/* Vincular cuenta Jira */}
    {scope === "mine" && !mine.linked && !broken && (
      <div class="bg-amber-500/5 border border-amber-500/20 rounded-2xl p-5 backdrop-blur-sm">
        <div class="flex items-start gap-3">
          <div class="p-2 bg-amber-500/10 rounded-lg flex-shrink-0">
            <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 005.656-5.656l-1.1 1.1" />
            </svg>
          </div>
          <div class="flex-1">
            <h2 class="text-sm font-semibold text-amber-400">Vincula tu cuenta de Jira</h2>
            <p class="mt-1 text-xs text-gray-400">
              Para ver tus tickets, vincula tu usuario de Jira (se busca por tu correo {user.email}).
            </p>
            <form method="POST" action="/api/tickets/link" class="mt-3">
              <button class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-amber-500 to-amber-600 rounded-xl text-xs font-medium text-white shadow-lg shadow-amber-500/25 hover:shadow-amber-500/40 hover:-translate-y-0.5 transition-all duration-300">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 005.656-5.656l-1.1 1.1" />
                </svg>
                Vincular mi cuenta
              </button>
            </form>
          </div>
        </div>
      </div>
    )}

    {broken && (
      <div class="bg-white/5 border border-white/5 rounded-xl px-5 py-4 text-sm text-gray-400 flex items-start gap-3">
        <svg class="w-5 h-5 text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>{providerMessages[current.provider] ?? "Fuente de tickets no disponible."}</span>
      </div>
    )}

    {/* Lista principal */}
    <div class="relative">
      <section class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl overflow-hidden hover:border-rose-500/20 transition-all duration-300">
        <div class="p-4 border-b border-white/5 flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <div class="p-1.5 bg-rose-500/10 rounded-lg">
              <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
            </div>
            <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">
              {scope === "mine" ? "Mis tickets" : "Mesón completo"}
            </span>
          </div>
          <span class="text-[10px] text-gray-500 bg-white/5 px-2 py-0.5 rounded-full border border-white/5">
            {allVisible.length} tickets
          </span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full min-w-[700px] text-sm">
            <thead>
              <tr class="border-b border-white/5 text-left text-[10px] uppercase tracking-wider text-gray-400">
                <th class="px-4 py-3 font-semibold">Ticket</th>
                <th class="px-4 py-3 font-semibold">Estado</th>
                <th class="px-4 py-3 font-semibold">Prioridad</th>
                <th class="px-4 py-3 font-semibold">Asignado</th>
                <th class="px-4 py-3 font-semibold">Actualizado</th>
              </tr>
            </thead>
            <tbody>
              {visible.length === 0 ? (
                <tr>
                  <td colspan="5" class="px-4 py-12 text-center text-gray-500">
                    <span class="text-3xl block mb-2">📭</span>
                    {scope === "mine" && !mine.linked 
                      ? "Vincula tu cuenta para ver tus tickets." 
                      : "Sin tickets en este ámbito."}
                  </td>
                </tr>
              ) : (
                visible.map((ticket) => (
                  <tr class:list={[
                    "border-b border-white/5 last:border-b-0 transition-colors duration-200",
                    ticket.key === selectedKey 
                      ? "bg-rose-500/10 border-l-2 border-l-rose-500" 
                      : "hover:bg-white/5",
                  ]}>
                    <td class="px-4 py-3">
                      <div class="flex items-center gap-2">
                        <a 
                          href={listHref(ticket)} 
                          class="font-mono text-xs font-medium text-rose-400 hover:text-rose-300 transition-colors duration-200 hover:underline"
                        >
                          {ticket.key}
                        </a>
                        {ticket.is_mine && scope === "all" && (
                          <span class="rounded-full bg-rose-500/20 px-2 py-0.5 text-[9px] font-medium text-rose-400 border border-rose-500/20">
                            mío
                          </span>
                        )}
                      </div>
                      <p class="mt-0.5 text-xs text-gray-300 truncate max-w-[280px]" title={ticket.summary}>
                        {ticket.summary}
                      </p>
                    </td>
                    <td class="px-4 py-3">
                      <TaskStatusBadge status={statusKey(ticket)} />
                      <span class="ml-1.5 text-[10px] text-gray-500">{ticket.status_name}</span>
                    </td>
                    <td class="px-4 py-3">
                      <TaskPriorityBadge priority={priorityKey(ticket)} />
                    </td>
                    <td class="px-4 py-3 text-xs text-gray-400">
                      {ticket.assignee_name ?? <span class="italic text-gray-600">sin asignar</span>}
                    </td>
                    <td class="px-4 py-3 text-[10px] tabular-nums text-gray-500">
                      {ticket.updated}
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>

        {/* Paginación */}
        {totalPages > 1 && (
          <div class="border-t border-white/5 px-4 py-3 flex items-center justify-between">
            <div class="text-[10px] text-gray-500">
              Mostrando {startIndex + 1}–{Math.min(startIndex + PAGE_SIZE, allVisible.length)} de {allVisible.length}
            </div>
            <div class="flex items-center gap-1">
              {/* Primera página */}
              {safePage > 2 && (
                <a href={pageHref(1)} class="p-1.5 rounded-lg text-gray-400 hover:text-white hover:bg-white/10 transition-all duration-200" title="Primera página">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
                  </svg>
                </a>
              )}
              
              {/* Anterior */}
              {hasPrev && (
                <a href={pageHref(safePage - 1)} class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium text-rose-400 hover:text-rose-300 hover:bg-rose-500/10 transition-all duration-200">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                  </svg>
                  Anterior
                </a>
              )}

              {/* Números de página */}
              <div class="flex items-center gap-0.5">
                {Array.from({ length: totalPages }, (_, i) => i + 1)
                  .filter(p => p === 1 || p === totalPages || Math.abs(p - safePage) <= 1)
                  .map((p, idx, arr) => (
                    <>
                      {idx > 0 && arr[idx - 1] !== p - 1 && (
                        <span class="px-1 text-gray-600 text-xs">…</span>
                      )}
                      <a
                        href={pageHref(p)}
                        class:list={[
                          "min-w-[28px] h-7 flex items-center justify-center rounded-lg text-xs font-medium transition-all duration-200",
                          p === safePage
                            ? "bg-gradient-to-r from-rose-500 to-rose-600 text-white shadow-lg shadow-rose-500/25"
                            : "text-gray-400 hover:text-white hover:bg-white/10",
                        ]}
                      >
                        {p}
                      </a>
                    </>
                  ))}
              </div>

              {/* Siguiente */}
              {hasNext && (
                <a href={pageHref(safePage + 1)} class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium text-rose-400 hover:text-rose-300 hover:bg-rose-500/10 transition-all duration-200">
                  Siguiente
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              )}

              {/* Última página */}
              {safePage < totalPages - 1 && (
                <a href={pageHref(totalPages)} class="p-1.5 rounded-lg text-gray-400 hover:text-white hover:bg-white/10 transition-all duration-200" title="Última página">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        )}
      </section>

      {/* Modal Overlay & Panel Flotante de Detalle */}
      {selectedKey && (
        <div  style="position:fixed; top:20px; left:-435px; width:100vw; height:100vh; z-index:9999; background-color:rgba(0,0,0,0.5); backdrop-filter:blur(4px); display:flex; align-items:center; justify-content:center; animation:fadeIn 0.3s forwards;">
          {/* Fondo para cerrar al hacer click afuera */}
          <a 
            href={`/dashboard/tickets?scope=${scope}&page=${safePage}`} 
            class="fixed inset-0 cursor-default" 
            aria-label="Cerrar modal"
          ></a>

          <aside class="relative z-10 w-full max-w-2xl h-full bg-[#0d0f17] border-l border-white/10 p-6 space-y-4 overflow-y-auto shadow-2xl scrollbar-thin">
            {detail ? (
              <>
                {/* Modal principal de detalle */}
                <section class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl overflow-hidden hover:border-rose-500/20 transition-all duration-300">
                  {/* Header */}
                  <div class="p-5 border-b border-white/5">
                    <div class="flex items-start justify-between gap-3">
                      <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2 mb-1">
                          <span class="font-mono text-xs font-medium text-rose-400">{detail.key}</span>
                          {detail.is_mine && (
                            <span class="rounded-full bg-rose-500/20 px-2 py-0.5 text-[9px] font-medium text-rose-400 border border-rose-500/20">
                              tuyo
                            </span>
                          )}
                        </div>
                        <h2 class="text-base font-semibold text-white leading-tight">{detail.summary}</h2>
                      </div>
                      <div class="flex items-center gap-2 flex-shrink-0">
                        <a 
                          href={detail.url} 
                          target="_blank" 
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-[10px] font-medium text-rose-400 hover:text-rose-300 hover:bg-rose-500/10 border border-rose-500/20 transition-all duration-200"
                        >
                          Ver en Jira
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        </a>
                        <a 
                          href={`/dashboard/tickets?scope=${scope}&page=${safePage}`}
                          class="p-1.5 rounded-lg text-gray-400 hover:text-white hover:bg-white/10 transition-all duration-200"
                          title="Cerrar detalle"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                          </svg>
                        </a>
                      </div>
                    </div>

                    {/* Badges */}
                    <div class="mt-3 flex flex-wrap items-center gap-2">
                      <TaskStatusBadge status={statusKey(detail)} />
                      <span class="text-[10px] text-gray-500">{detail.status_name}</span>
                      <TaskPriorityBadge priority={priorityKey(detail)} />
                      {detail.resolved && (
                        <span class="rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-[10px] font-medium text-emerald-400 border border-emerald-500/20">
                          ✓ resuelto {detail.resolved}
                        </span>
                      )}
                    </div>
                  </div>

                  {/* Metadatos */}
                  <div class="p-5 border-b border-white/5">
                    <dl class="grid grid-cols-2 gap-3 text-xs">
                      <div class="bg-white/5 rounded-lg p-2.5">
                        <dt class="text-[10px] text-gray-500 uppercase tracking-wider mb-0.5">Asignado</dt>
                        <dd class="font-medium text-gray-200 truncate">{detail.assignee_name ?? "sin asignar"}</dd>
                      </div>
                      <div class="bg-white/5 rounded-lg p-2.5">
                        <dt class="text-[10px] text-gray-500 uppercase tracking-wider mb-0.5">Solicitante</dt>
                        <dd class="font-medium text-gray-200 truncate">{detail.reporter_name ?? "—"}</dd>
                      </div>
                      <div class="bg-white/5 rounded-lg p-2.5">
                        <dt class="text-[10px] text-gray-500 uppercase tracking-wider mb-0.5">Creado</dt>
                        <dd class="font-medium tabular-nums text-gray-200 text-[11px]">{detail.created}</dd>
                      </div>
                      <div class="bg-white/5 rounded-lg p-2.5">
                        <dt class="text-[10px] text-gray-500 uppercase tracking-wider mb-0.5">Actualizado</dt>
                        <dd class="font-medium tabular-nums text-gray-200 text-[11px]">{detail.updated}</dd>
                      </div>
                    </dl>
                  </div>

                  {/* Descripción */}
                  {detail.description && (
                    <div class="p-5 border-b border-white/5">
                      <h3 class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-2 flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h12" />
                        </svg>
                        Descripción
                      </h3>
                      <p class="whitespace-pre-line text-xs text-gray-300 leading-relaxed">{detail.description}</p>
                    </div>
                  )}

                  {/* Adjuntos */}
                  {detail.attachments.length > 0 && (
                    <div class="p-5 border-b border-white/5">
                      <h3 class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-2 flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                        </svg>
                        Adjuntos ({detail.attachments.length})
                      </h3>
                      <ul class="flex flex-wrap gap-2">
                        {detail.attachments.map((attachment: TicketAttachment) => (
                          <li 
                            class="inline-flex items-center gap-1.5 rounded-lg bg-white/5 border border-white/10 px-2.5 py-1.5 text-[10px] font-medium text-gray-300 hover:bg-white/10 hover:border-rose-500/20 transition-all duration-200"
                            title={attachment.mime ?? undefined}
                          >
                            <span>📎</span>
                            <span class="truncate max-w-[140px]">{attachment.filename}</span>
                            <span class="text-gray-500">· {attachment.size_kb} KB</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </section>

                {/* Comentarios */}
                <section class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl overflow-hidden hover:border-rose-500/20 transition-all duration-300">
                  <div class="p-4 border-b border-white/5">
                    <h3 class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 flex items-center gap-1.5">
                      <svg class="w-3.5 h-3.5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                      </svg>
                      Comentarios
                      <span class="ml-auto px-2 py-0.5 text-[9px] font-bold bg-rose-500/20 text-rose-400 rounded-full">
                        {detail.comments_count}
                      </span>
                    </h3>
                  </div>
                  <div class="p-4">
                    {detail.comments_count === 0 ? (
                      <div class="text-center py-6 text-gray-500">
                        <span class="text-2xl block mb-2">💬</span>
                        <p class="text-xs">Sin comentarios.</p>
                      </div>
                    ) : (
                      <ol class="space-y-3 max-h-80 overflow-y-auto scrollbar-thin pr-1">
                        {detail.comments.map((comment: TicketComment) => (
                          <li class="bg-white/5 border border-white/5 rounded-xl p-3 hover:bg-white/10 transition-colors duration-200">
                            <div class="flex items-center justify-between gap-2 mb-2">
                              <div class="flex items-center gap-2">
                                <div class="w-5 h-5 rounded-full bg-gradient-to-r from-rose-500 to-rose-600 flex items-center justify-center text-[8px] font-bold text-white">
                                  {(comment.author ?? "?").charAt(0).toUpperCase()}
                                </div>
                                <span class="text-[10px] font-medium text-gray-300">{comment.author ?? "—"}</span>
                              </div>
                              <span class="text-[9px] tabular-nums text-gray-500">{comment.created}</span>
                            </div>
                            <p class="whitespace-pre-line text-[11px] text-gray-400 leading-relaxed">{comment.body}</p>
                          </li>
                        ))}
                      </ol>
                    )}
                  </div>
                </section>
              </>
            ) : (
              <section class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl p-8 text-center">
                <span class="text-3xl block mb-3">🔍</span>
                <p class="text-sm text-gray-400">
                  No se pudo cargar el ticket <span class="font-medium text-white">{selectedKey}</span>.
                </p>
                <a 
                  href={`/dashboard/tickets?scope=${scope}&page=${safePage}`} 
                  class="mt-3 inline-flex items-center gap-1.5 text-xs font-medium text-rose-400 hover:text-rose-300 transition-colors duration-200"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                  </svg>
                  Volver a la lista
                </a>
              </section>
            )}
          </aside>
        </div>
      )}
    </div>

    {current.has_more && (
      <p class="text-[10px] text-gray-500 bg-white/5 border border-white/5 rounded-xl px-4 py-2.5">
        <span class="text-gray-600">ℹ️</span> Se muestran los primeros {current.total} tickets del ámbito (hay más en Jira). Listas: caché 60 s · KPIs: 5 min.
      </p>
    )}
  </div>
</DashboardLayout>

<style>
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .animate-fadeIn {
    animation: fadeIn 0.2s ease-out forwards;
  }

  .scrollbar-thin::-webkit-scrollbar {
    width: 3px;
  }
  .scrollbar-thin::-webkit-scrollbar-track {
    background: transparent;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: rgba(232, 62, 140, 0.3);
    border-radius: 10px;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb:hover {
    background: rgba(232, 62, 140, 0.5);
  }
</style>