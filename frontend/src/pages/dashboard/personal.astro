---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import FlashMessage from "../../components/FlashMessage.astro";
import ShiftBadge from "../../components/ShiftBadge.astro";
import ShiftLegend from "../../components/ShiftLegend.astro";
import SourceChip from "../../components/SourceChip.astro";
import WeekNav from "../../components/WeekNav.astro";
import {
    addDaysIso,
    formatRange,
    formatShortDate,
} from "../../lib/format";
import { CUSTOM_DAY_STYLE, shiftStyle } from "../../lib/shift-styles";
import {
    fetchHolidays,
    fetchShifts,
    fetchTeamWeek,
    type HolidaysYear,
    type ShiftDefinition,
    type TeamWeek,
} from "../../services/api";

const token = Astro.locals.token ?? "";
const user = Astro.locals.user;
if (!user) return Astro.redirect("/login");
if (user.role !== "SUPERVISOR" && user.role !== "ADMIN") {
    return Astro.redirect("/dashboard");
}

const weekParam = Astro.url.searchParams.get("week");
const requestedWeek =
    weekParam && /^\d{4}-\d{2}-\d{2}$/.test(weekParam) ? weekParam : undefined;

let team: TeamWeek;
let shifts: ShiftDefinition[];
let holidays: HolidaysYear | null = null;
try {
    team = await fetchTeamWeek(token, requestedWeek);
    shifts = await fetchShifts(token);
    holidays = await fetchHolidays(token).catch(() => null);
} catch {
    return Astro.redirect("/login");
}

const weekOverrides = team.members
    .flatMap((member) => member.day_overrides)
    .sort((a, b) => a.date.localeCompare(b.date));
const isAdmin = user.role === "ADMIN";
const today = team.today;
const selectable = shifts.filter((shift) => shift.id !== "HOLIDAY");
const range = formatRange(team.week_start, addDaysIso(team.week_start, 6));
const roleLabels: Record<string, string> = {
    SUPERVISOR: "Supervisor",
    EMPLOYEE: "Empleado",
    ADMIN: "Administrador",
};
---

<DashboardLayout title="Personal" user={user}>
    <div class="space-y-8">
        {/* Encabezado estilo Nexus Central */}
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h1 class="text-3xl font-bold text-white tracking-tight flex items-center gap-3">
                    <span>Personal</span>
                    <span class="text-sm font-normal text-gray-500 tracking-normal bg-white/5 px-3 py-1 rounded-full border border-white/5">
                        {team.members.length} empleados
                    </span>
                </h1>
                <div class="mt-2 flex flex-wrap items-center gap-2.5">
                    <span class="text-xs text-gray-500 flex items-center gap-1.5">
                        <span class="inline-block w-1.5 h-1.5 bg-emerald-400 rounded-full"></span>
                        Datos sincronizados
                    </span>
                    <span class="text-gray-600 text-xs">|</span>
                    <span class="text-xs text-gray-500">Semana del {range}</span>
                </div>
            </div>
            <div class="flex items-center gap-3 px-4 py-2 bg-white/5 rounded-full border border-white/5">
                <span class="text-xs text-gray-400">Semana actual</span>
                <span class="text-xs text-rose-400 font-medium">{team.week_start}</span>
            </div>
        </div>

        <FlashMessage />
        
        <div class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl p-4 hover:bg-white/8 transition-all duration-300">
            <WeekNav basePath="/dashboard/personal" weekStart={team.week_start} today={today} />
        </div>

        {/* Horario personalizado - estilo Nexus */}
        <details class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl hover:border-rose-500/20 transition-all duration-300">
            <summary class="cursor-pointer list-none px-6 py-4 text-sm font-semibold text-white hover:text-rose-400 transition-colors duration-200 [&::-webkit-details-marker]:hidden flex items-center gap-2.5">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                Horario personalizado (un día)
                <span class="ml-auto text-xs font-normal text-gray-500 bg-white/5 px-2 py-0.5 rounded-full border border-white/5">
                    {weekOverrides.length} cambios
                </span>
            </summary>
            <div class="grid gap-6 border-t border-white/5 p-6 lg:grid-cols-2">
                {/* Cambio de turno */}
                <form method="POST" action="/api/day-overrides" class="space-y-4 bg-white/5 rounded-xl p-5 border border-white/5">
                    <input type="hidden" name="next" value={`/dashboard/personal?week=${team.week_start}`} />
                    <h3 class="text-sm font-semibold text-white flex items-center gap-2">
                        <span class="w-1 h-4 bg-amber-500 rounded-full"></span>
                        Cambio de turno (un solo día)
                    </h3>
                    <div>
                        <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Empleado</label>
                        <select name="user_id" required class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:border-rose-500/40 focus:outline-none focus:ring-2 focus:ring-rose-500/20 transition-all duration-300">
                            {team.members.map((member) => (
                                <option value={member.user.id} class="bg-[#0a0a0f] text-white">{member.user.name}</option>
                            ))}
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Fecha</label>
                            <input type="date" name="date" min={today} required class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:border-rose-500/40 focus:outline-none focus:ring-2 focus:ring-rose-500/20 transition-all duration-300" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Turno ese día</label>
                            <select name="shift" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:border-rose-500/40 focus:outline-none focus:ring-2 focus:ring-rose-500/20 transition-all duration-300">
                                {selectable.map((shift) => (
                                    <option value={shift.id} class="bg-[#0a0a0f] text-white">{shift.name}</option>
                                ))}
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Motivo (opcional)</label>
                        <input type="text" name="reason" maxlength="500" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white placeholder:text-gray-500 focus:border-rose-500/40 focus:outline-none focus:ring-2 focus:ring-rose-500/20 transition-all duration-300" placeholder="Ej.: cita médica..." />
                    </div>
                    <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-amber-500 to-amber-600 rounded-xl text-sm font-medium text-white shadow-lg shadow-amber-500/25 hover:shadow-amber-500/40 hover:-translate-y-0.5 transition-all duration-300">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        Aplicar cambio de turno
                    </button>
                </form>

                {/* Horas exactas */}
                <form method="POST" action="/api/day-overrides" class="space-y-4 bg-white/5 rounded-xl p-5 border border-white/5">
                    <input type="hidden" name="next" value={`/dashboard/personal?week=${team.week_start}`} />
                    <h3 class="text-sm font-semibold text-white flex items-center gap-2">
                        <span class="w-1 h-4 bg-amber-500 rounded-full"></span>
                        Horas exactas (un solo día)
                    </h3>
                    <p class="text-xs text-gray-500">Horario puntual (p. ej. 09:00–13:00). Tiene prioridad sobre festivos y reducciones.</p>
                    <div>
                        <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Empleado</label>
                        <select name="user_id" required class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:border-rose-500/40 focus:outline-none focus:ring-2 focus:ring-rose-500/20 transition-all duration-300">
                            {team.members.map((member) => (
                                <option value={member.user.id} class="bg-[#0a0a0f] text-white">{member.user.name}</option>
                            ))}
                        </select>
                    </div>
                    <div class="grid grid-cols-3 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Fecha</label>
                            <input type="date" name="date" min={today} required class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:border-rose-500/40 focus:outline-none focus:ring-2 focus:ring-rose-500/20 transition-all duration-300" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Inicio</label>
                            <input type="time" name="start" required class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:border-rose-500/40 focus:outline-none focus:ring-2 focus:ring-rose-500/20 transition-all duration-300" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Fin</label>
                            <input type="time" name="end" required class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:border-rose-500/40 focus:outline-none focus:ring-2 focus:ring-rose-500/20 transition-all duration-300" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Motivo (opcional)</label>
                        <input type="text" name="reason" maxlength="500" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white placeholder:text-gray-500 focus:border-rose-500/40 focus:outline-none focus:ring-2 focus:ring-rose-500/20 transition-all duration-300" placeholder="Ej.: reunión especial..." />
                    </div>
                    <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-amber-500 to-amber-600 rounded-xl text-sm font-medium text-white shadow-lg shadow-amber-500/25 hover:shadow-amber-500/40 hover:-translate-y-0.5 transition-all duration-300">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Aplicar horas
                    </button>
                </form>
            </div>
        </details>

        {/* Tabla de horarios */}
        <div class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl overflow-hidden hover:border-rose-500/20 transition-all duration-300">
            <div class="p-4 border-b border-white/5 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <div class="p-1.5 bg-rose-500/10 rounded-lg">
                        <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">Calendario semanal</span>
                </div>
                <span class="text-[10px] text-gray-500 bg-white/5 px-2 py-0.5 rounded-full border border-white/5">
                    {team.members.length} empleados
                </span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full min-w-[900px] text-sm">
                    <thead>
                        <tr class="border-b border-white/5 text-left text-xs uppercase tracking-wider text-gray-400">
                            <th class="px-4 py-3 font-semibold">Empleado</th>
                            <th class="px-4 py-3 font-semibold">Turno de la semana</th>
                            {team.members[0]?.days.map((day) => (
                                <th
                                    class:list={[
                                        "px-2 py-3 text-center font-semibold",
                                        day.date === today && "text-rose-400",
                                    ]}
                                >
                                    <div class="text-[10px] uppercase tracking-wider">{day.day_name.slice(0, 3)}</div>
                                    <div class="font-normal text-gray-500 text-[10px] tabular-nums">
                                        {formatShortDate(day.date)}
                                    </div>
                                </th>
                            ))}
                            {isAdmin && (
                                <th class="px-4 py-3 font-semibold text-center text-[10px]">Asignar turno</th>
                            )}
                        </tr>
                    </thead>
                    <tbody>
                        {team.members.map((member) => (
                            <tr class="border-b border-white/5 last:border-b-0 hover:bg-white/5 transition-colors duration-200">
                                <td class="px-4 py-3">
                                    <div class="flex items-center gap-2.5">
                                        <div class="flex-shrink-0 h-8 w-8 rounded-full bg-gradient-to-r from-rose-500 to-rose-600 flex items-center justify-center text-xs font-bold text-white shadow-lg shadow-rose-500/20">
                                            {member.user.name.charAt(0).toUpperCase()}
                                        </div>
                                        <div>
                                            <div class="font-medium text-white text-sm">
                                                {member.user.name}
                                            </div>
                                            <div class="text-[10px] text-gray-500">
                                                {roleLabels[member.user.role] ?? member.user.role}
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="flex flex-col items-start gap-1.5">
                                        <ShiftBadge shift={member.shift} />
                                        <SourceChip source={member.source} size="sm" />
                                        {isAdmin && member.override_change_id && (
                                            <form method="POST" action="/api/novedades/revert">
                                                <input type="hidden" name="change_id" value={member.override_change_id} />
                                                <input type="hidden" name="next" value={`/dashboard/personal?week=${team.week_start}`} />
                                                <button type="submit" class="text-[10px] font-medium text-rose-400 hover:text-rose-300 transition-colors duration-200 hover:underline">
                                                    Quitar cambio
                                                </button>
                                            </form>
                                        )}
                                    </div>
                                </td>
                                {member.days.map((day) => {
                                    const holiday = day.is_holiday && day.start !== null;
                                    const cellStyle = day.is_custom
                                        ? (day.custom_shift ? shiftStyle(day.custom_shift.color) : CUSTOM_DAY_STYLE)
                                        : day.start === null
                                            ? null
                                            : shiftStyle(holiday ? "purple" : member.shift.color);
                                    const title = [
                                        day.is_custom ? "Horario personalizado" : null,
                                        day.is_holiday ? `Festivo: ${day.holiday_name}` : null,
                                    ].filter(Boolean).join(" · ") || undefined;
                                    return (
                                        <td
                                            class:list={[
                                                "px-2 py-3 text-center",
                                                day.date === today && "bg-rose-500/5",
                                            ]}
                                        >
                                            {day.start ? (
                                                <span
                                                    class:list={[
                                                        "inline-block rounded-md px-2 py-1 text-xs font-medium tabular-nums",
                                                        cellStyle?.badge,
                                                        day.is_custom && "border border-amber-500/30",
                                                    ]}
                                                    title={title}
                                                >
                                                    {day.start}–{day.end}
                                                    {day.is_custom && <span class="ml-0.5 text-[9px] opacity-70">✏️</span>}
                                                </span>
                                            ) : (
                                                <span class:list={["text-slate-300", day.is_holiday && "text-violet-400"]} title={title}>—</span>
                                            )}
                                        </td>
                                    );
                                })}
                                {isAdmin && (
                                    <td class="px-4 py-3">
                                        <form method="POST" action="/api/novedades" class="flex items-center gap-2">
                                            <input type="hidden" name="next" value={`/dashboard/personal?week=${team.week_start}`} />
                                            <input type="hidden" name="user_id" value={member.user.id} />
                                            <input type="hidden" name="week_start" value={team.week_start} />
                                            <select name="requested_shift" class="bg-white/5 border border-white/10 rounded-lg px-2 py-1.5 text-xs text-white focus:border-rose-500/40 focus:outline-none focus:ring-2 focus:ring-rose-500/20 transition-all duration-300">
                                                {selectable.map((shift) => (
                                                    <option value={shift.id} class="bg-[#0a0a0f] text-white">
                                                        {shift.name}
                                                    </option>
                                                ))}
                                            </select>
                                            <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 bg-gradient-to-r from-rose-500 to-rose-600 rounded-lg text-xs font-medium text-white shadow-lg shadow-rose-500/25 hover:shadow-rose-500/40 hover:-translate-y-0.5 transition-all duration-300">
                                                Asignar
                                            </button>
                                        </form>
                                    </td>
                                )}
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>

        {/* Horarios personalizados de la semana */}
        {weekOverrides.length > 0 && (
            <section class="space-y-4">
                <div class="flex items-center gap-2.5">
                    <div class="p-1.5 bg-amber-500/10 rounded-lg">
                        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                    </div>
                    <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400">
                        Horarios personalizados de la semana
                    </h2>
                    <span class="ml-auto px-2.5 py-0.5 text-[10px] font-bold bg-amber-500/20 text-amber-400 rounded-full">
                        {weekOverrides.length}
                    </span>
                </div>
                <div class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl overflow-hidden hover:border-amber-500/20 transition-all duration-300">
                    <ul class="divide-y divide-white/5">
                        {weekOverrides.map((override) => (
                            <li class="flex flex-wrap items-center gap-3 px-4 py-3 text-sm hover:bg-white/5 transition-colors duration-200">
                                <div class="flex items-center gap-2.5 min-w-[150px]">
                                    <div class="flex-shrink-0 h-6 w-6 rounded-full bg-amber-500/20 flex items-center justify-center text-[9px] font-bold text-amber-400">
                                        {override.user.name.charAt(0).toUpperCase()}
                                    </div>
                                    <span class="font-medium text-white text-xs">{override.user.name}</span>
                                </div>
                                <span class="text-xs text-gray-500 tabular-nums">{formatShortDate(override.date)}</span>
                                {override.shift ? (
                                    <ShiftBadge shift={override.shift} size="sm" />
                                ) : (
                                    <span class="inline-flex items-center gap-1 rounded-full bg-amber-500/10 px-2.5 py-0.5 text-[10px] font-medium text-amber-400 border border-amber-500/20">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        {override.start}–{override.end}
                                    </span>
                                )}
                                <span class="min-w-0 flex-1 truncate text-gray-400 text-xs" title={override.reason ?? undefined}>
                                    {override.reason ?? "—"}
                                </span>
                                <span class="text-[10px] text-gray-500">por {override.created_by.name}</span>
                                <form method="POST" action="/api/day-overrides/delete">
                                    <input type="hidden" name="override_id" value={override.id} />
                                    <input type="hidden" name="next" value={`/dashboard/personal?week=${team.week_start}`} />
                                    <button type="submit" class="text-[10px] font-medium text-rose-400 hover:text-rose-300 transition-colors duration-200 hover:underline">
                                        Quitar
                                    </button>
                                </form>
                            </li>
                        ))}
                    </ul>
                </div>
            </section>
        )}

        {/* Información de administrador */}
        {isAdmin && (
            <div class="bg-white/5 border border-white/5 rounded-xl px-4 py-3 text-xs text-gray-500 flex items-start gap-3">
                <svg class="w-4 h-4 text-gray-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>La asignación directa queda como cambio aprobado: sobrescribe la rotación de esa semana y puede revertirse con «Quitar cambio».</span>
            </div>
        )}

        {/* ShiftLegend */}
        <ShiftLegend shifts={shifts} />

        {/* Festivos */}
        {holidays && (
            <section class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl p-5 hover:border-rose-500/20 transition-all duration-300">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-2.5">
                        <div class="p-1.5 bg-rose-500/10 rounded-lg">
                            <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400">
                            Festivos {holidays.year}
                        </h2>
                    </div>
                    <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[10px] font-medium border ${holidays.provider === "google" ? "bg-emerald-500/10 text-emerald-400 border-emerald-500/20" : "bg-gray-500/10 text-gray-400 border-gray-500/20"}`} title="Fuente del calendario de festivos">
                        <span class={`h-1.5 w-1.5 rounded-full ${holidays.provider === "google" ? "bg-emerald-400" : "bg-gray-500"}`} />
                        {holidays.provider === "google" ? "Calendario oficial (Google Calendar)" : "Cálculo local"}
                    </span>
                </div>
                <ul class="mt-3 grid gap-x-6 gap-y-1.5 text-sm text-gray-300 sm:grid-cols-2 lg:grid-cols-3">
                    {holidays.holidays.map((holiday) => (
                        <li class="flex items-center gap-2 group hover:bg-white/5 rounded-lg px-2 py-1 transition-colors duration-200">
                            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-purple-500/60"></span>
                            <span class="tabular-nums text-gray-500 text-xs">{formatShortDate(holiday.date)}</span>
                            <span class="truncate text-xs text-gray-400 group-hover:text-white transition-colors duration-200" title={holiday.name}>
                                {holiday.name}
                            </span>
                        </li>
                    ))}
                </ul>
            </section>
        )}
    </div>
</DashboardLayout>

<style>
    select option {
        background-color: #0a0a0f;
        color: white;
    }
    
    input[type="date"]::-webkit-calendar-picker-indicator,
    input[type="time"]::-webkit-calendar-picker-indicator {
        filter: invert(0.5);
        cursor: pointer;
    }
    
    input[type="date"]::-webkit-calendar-picker-indicator:hover,
    input[type="time"]::-webkit-calendar-picker-indicator:hover {
        filter: invert(0.8);
    }
</style>