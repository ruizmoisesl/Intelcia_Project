---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import FlashMessage from "../../components/FlashMessage.astro";
import ShiftBadge from "../../components/ShiftBadge.astro";
import ShiftLegend from "../../components/ShiftLegend.astro";
import SourceChip from "../../components/SourceChip.astro";
import WeekNav from "../../components/WeekNav.astro";
import {
    addDaysIso,
    formatRange,
    formatShortDate,
} from "../../lib/format";
import { shiftStyle } from "../../lib/shift-styles";
import {
    fetchHolidays,
    fetchShifts,
    fetchTeamWeek,
    type HolidaysYear,
    type ShiftDefinition,
    type TeamWeek,
} from "../../services/api";

const token = Astro.locals.token ?? "";
const user = Astro.locals.user;
if (!user) return Astro.redirect("/login");
if (user.role !== "SUPERVISOR" && user.role !== "ADMIN") {
    return Astro.redirect("/dashboard");
}

const weekParam = Astro.url.searchParams.get("week");
const requestedWeek =
    weekParam && /^\d{4}-\d{2}-\d{2}$/.test(weekParam) ? weekParam : undefined;

let team: TeamWeek;
let shifts: ShiftDefinition[];
let holidays: HolidaysYear | null = null;
try {
    team = await fetchTeamWeek(token, requestedWeek);
    shifts = await fetchShifts(token);
    holidays = await fetchHolidays(token).catch(() => null);
} catch {
    return Astro.redirect("/login");
}

const isAdmin = user.role === "ADMIN";
const today = team.today;
const selectable = shifts.filter((shift) => shift.id !== "HOLIDAY");
const range = formatRange(team.week_start, addDaysIso(team.week_start, 6));
const roleLabels: Record<string, string> = {
    SUPERVISOR: "Supervisor",
    EMPLOYEE: "Empleado",
    ADMIN: "Administrador",
};
---

<DashboardLayout title="Personal" user={user}>
    <div class="space-y-8">
        {/* Encabezado estilo Nexus Central - basado en imagen 2 */}
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h1 class="text-3xl font-bold text-white tracking-tight flex items-center gap-3">
                    <span>Personal</span>
                    <span class="text-sm font-normal text-gray-500 tracking-normal bg-white/5 px-3 py-1 rounded-full border border-white/5">
                        {team.members.length} empleados
                    </span>
                </h1>
                <div class="mt-2 flex flex-wrap items-center gap-2.5">
                    <span class="text-xs text-gray-500 flex items-center gap-1.5">
                        <span class="inline-block w-1.5 h-1.5 bg-emerald-400 rounded-full"></span>
                        Datos sincronizados
                    </span>
                    <span class="text-gray-600 text-xs">|</span>
                    <span class="text-xs text-gray-500">Semana del {range}</span>
                </div>
            </div>
            <div class="flex items-center gap-3 px-4 py-2 bg-white/5 rounded-full border border-white/5">
                <span class="text-xs text-gray-400">Semana actual</span>
                <span class="text-xs text-rose-400 font-medium">{team.week_start}</span>
            </div>
        </div>

        <FlashMessage />
        
        <div class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl p-4 hover:bg-white/8 transition-all duration-300">
            <WeekNav basePath="/dashboard/personal" weekStart={team.week_start} today={today} />
        </div>

        {/* Tabla de horarios - estilo calendario de la imagen 2 */}
        <div class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl overflow-hidden hover:border-rose-500/20 transition-all duration-300">
            <div class="p-4 border-b border-white/5 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <div class="p-1.5 bg-rose-500/10 rounded-lg">
                        <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">Calendario semanal</span>
                </div>
                <span class="text-[10px] text-gray-500 bg-white/5 px-2 py-0.5 rounded-full border border-white/5">
                    {team.members.length} empleados
                </span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full min-w-[900px] text-sm">
                    <thead>
                        <tr class="border-b border-white/5 text-left text-xs uppercase tracking-wider text-gray-400">
                            <th class="px-4 py-3 font-semibold">Empleado</th>
                            <th class="px-4 py-3 font-semibold">Turno de la semana</th>
                            {team.members[0]?.days.map((day) => (
                                <th
                                    class:list={[
                                        "px-2 py-3 text-center font-semibold",
                                        day.date === today &&
                                            "text-rose-400",
                                    ]}
                                >
                                    <div class="text-[10px] uppercase tracking-wider">{day.day_name.slice(0, 3)}</div>
                                    <div class="font-normal text-gray-500 text-[10px] tabular-nums">
                                        {formatShortDate(day.date)}
                                    </div>
                                </th>
                            ))}
                            {isAdmin && (
                                <th class="px-4 py-3 font-semibold text-center text-[10px]">Asignar turno</th>
                            )}
                        </tr>
                    </thead>
                    <tbody>
                        {team.members.map((member) => (
                            <tr class="border-b border-white/5 last:border-b-0 hover:bg-white/5 transition-colors duration-200">
                                <td class="px-4 py-3">
                                    <div class="flex items-center gap-2.5">
                                        <div class="flex-shrink-0 h-8 w-8 rounded-full bg-gradient-to-r from-rose-500 to-rose-600 flex items-center justify-center text-xs font-bold text-white shadow-lg shadow-rose-500/20">
                                            {member.user.name.charAt(0).toUpperCase()}
                                        </div>
                                        <div>
                                            <div class="font-medium text-white text-sm">
                                                {member.user.name}
                                            </div>
                                            <div class="text-[10px] text-gray-500">
                                                {roleLabels[member.user.role] ?? member.user.role}
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="flex flex-col items-start gap-1.5">
                                        <ShiftBadge shift={member.shift} />
                                        <SourceChip source={member.source} size="sm" />
                                        {isAdmin && member.override_change_id && (
                                            <form method="POST" action="/api/novedades/revert">
                                                <input type="hidden" name="change_id" value={member.override_change_id} />
                                                <input type="hidden" name="next" value={`/dashboard/personal?week=${team.week_start}`} />
                                                <button type="submit" class="text-[10px] font-medium text-rose-400 hover:text-rose-300 transition-colors duration-200 hover:underline">
                                                    Quitar cambio
                                                </button>
                                            </form>
                                        )}
                                    </div>
                                </td>
                                {member.days.map((day) => {
                                    const holiday = day.is_holiday && day.start !== null;
                                    const cellStyle = day.start === null ? null : shiftStyle(day.is_holiday ? "purple" : member.shift.color);
                                    return (
                                        <td
                                            class:list={[
                                                "px-2 py-3 text-center",
                                                day.date === today && "bg-rose-500/5",
                                            ]}
                                        >
                                            {day.start ? (
                                                <span
                                                    class:list={[
                                                        "inline-block rounded-md px-2 py-1 text-[11px] font-medium tabular-nums",
                                                        cellStyle?.badge,
                                                        holiday && "border border-purple-500/20",
                                                    ]}
                                                    title={holiday ? (day.holiday_name ?? "Festivo") : undefined}
                                                >
                                                    {day.start}–{day.end}
                                                </span>
                                            ) : (
                                                <span class="text-gray-600">—</span>
                                            )}
                                        </td>
                                    );
                                })}
                                {isAdmin && (
                                    <td class="px-4 py-3">
                                        <form method="POST" action="/api/novedades" class="flex items-center gap-2">
                                            <input type="hidden" name="next" value={`/dashboard/personal?week=${team.week_start}`} />
                                            <input type="hidden" name="user_id" value={member.user.id} />
                                            <input type="hidden" name="week_start" value={team.week_start} />
                                            <select
                                                name="requested_shift"
                                                class="bg-white/5 border border-white/10 rounded-lg px-2 py-1.5 text-xs text-white focus:border-rose-500/40 focus:outline-none focus:ring-2 focus:ring-rose-500/20 transition-all duration-300"
                                            >
                                                {selectable.map((shift) => (
                                                    <option value={shift.id} class="bg-[#0a0a0f] text-white">
                                                        {shift.name}
                                                    </option>
                                                ))}
                                            </select>
                                            <button
                                                type="submit"
                                                class="inline-flex items-center gap-1 px-3 py-1.5 bg-gradient-to-r from-rose-500 to-rose-600 rounded-lg text-xs font-medium text-white shadow-lg shadow-rose-500/25 hover:shadow-rose-500/40 hover:-translate-y-0.5 transition-all duration-300"
                                            >
                                                Asignar
                                            </button>
                                        </form>
                                    </td>
                                )}
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>

        {/* Información de administrador */}
        {isAdmin && (
            <div class="bg-white/5 border border-white/5 rounded-xl px-4 py-3 text-xs text-gray-500 flex items-start gap-3">
                <svg class="w-4 h-4 text-gray-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>La asignación directa queda como cambio aprobado: sobrescribe la rotación de esa semana y puede revertirse con «Quitar cambio».</span>
            </div>
        )}

        {/* ShiftLegend - estilo de la imagen 2 */}
        <ShiftLegend shifts={shifts} />

        {/* Festivos - estilo de la imagen 2 */}
        {holidays && (
            <section class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl p-5 hover:border-rose-500/20 transition-all duration-300">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-2.5">
                        <div class="p-1.5 bg-rose-500/10 rounded-lg">
                            <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400">
                            Festivos {holidays.year}
                        </h2>
                    </div>
                    <span
                        class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[10px] font-medium border ${
                            holidays.provider === "google"
                                ? "bg-emerald-500/10 text-emerald-400 border-emerald-500/20"
                                : "bg-gray-500/10 text-gray-400 border-gray-500/20"
                        }`}
                        title="Fuente del calendario de festivos"
                    >
                        <span class={`h-1.5 w-1.5 rounded-full ${holidays.provider === "google" ? "bg-emerald-400" : "bg-gray-500"}`} />
                        {holidays.provider === "google"
                            ? "Calendario oficial (Google Calendar)"
                            : "Cálculo local"}
                    </span>
                </div>
                <ul class="mt-3 grid gap-x-6 gap-y-1.5 text-sm text-gray-300 sm:grid-cols-2 lg:grid-cols-3">
                    {holidays.holidays.map((holiday) => (
                        <li class="flex items-center gap-2 group hover:bg-white/5 rounded-lg px-2 py-1 transition-colors duration-200">
                            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-purple-500/60"></span>
                            <span class="tabular-nums text-gray-500 text-xs">
                                {formatShortDate(holiday.date)}
                            </span>
                            <span class="truncate text-xs text-gray-400 group-hover:text-white transition-colors duration-200" title={holiday.name}>
                                {holiday.name}
                            </span>
                        </li>
                    ))}
                </ul>
            </section>
        )}
    </div>
</DashboardLayout>

<style>
    select option {
        background-color: #0a0a0f;
        color: white;
    }
</style>