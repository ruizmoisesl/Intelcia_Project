---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import Icon from "../../components/Icon.astro";
import InfoCard from "../../components/InfoCard.astro";
import ShiftBadge from "../../components/ShiftBadge.astro";
import SourceChip from "../../components/SourceChip.astro";
import { formatShortDate } from "../../lib/format";
import { shiftStyle } from "../../lib/shift-styles";
import {
  fetchMyChanges,
  fetchPendingChanges,
  fetchRotationPreview,
  fetchWeekSchedule,
  type RotationEntry,
  type ScheduleChange,
  type WeekSchedule,
} from "../../services/api";


const user = Astro.locals.user;
if (!user) return Astro.redirect("/login");
const token = Astro.locals.token ?? "";
const isApprover = user.role === "SUPERVISOR" || user.role === "ADMIN";

let week: WeekSchedule;
let rotation: { weeks: RotationEntry[] };
let myChanges: ScheduleChange[] = [];
let pendingCount = 0;
try {
  week = await fetchWeekSchedule(token);
  rotation = await fetchRotationPreview(token, 2);
  if (isApprover) {
    pendingCount = (await fetchPendingChanges(token)).length;
  } else {
    myChanges = await fetchMyChanges(token);
  }
} catch {
  return Astro.redirect("/login");
}

const today = week.today;
const todayEntry = week.days.find((day) => day.date === today) ?? null;
const workingDays = week.days.filter((day) => day.start !== null);
const nextWeek =
  rotation.weeks.find((entry) => entry.week_start > week.week_start) ?? null;
const myPending = myChanges.filter(
  (change) => change.status === "PENDING",
).length;

const dayShort: Record<string, string> = {
  MONDAY: "L",
  TUESDAY: "M",
  WEDNESDAY: "X",
  THURSDAY: "J",
  FRIDAY: "V",
  SATURDAY: "S",
  SUNDAY: "D",
};

const hour = new Date().getHours();
const greeting =
  hour < 12 ? "Buenos días" : hour < 20 ? "Buenas tardes" : "Buenas noches";
---

<DashboardLayout title="Dashboard" user={user}>
  <div class="space-y-8">
    {/* Encabezado estilo Nexus */}
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-white tracking-tight">
          {greeting}, <span class="text-rose-400">{user.name}</span>
          <span class="ml-2 text-2xl">👋</span>
        </h1>
        <p class="mt-1 text-sm text-gray-400">
          Resumen de tu jornada · <span class="text-rose-400/60">Nexus Central</span>
        </p>
      </div>
      <div class="flex items-center gap-3 px-3 py-1.5 bg-white/5 rounded-full border border-white/5">
        <span class="flex items-center gap-1.5 text-xs text-gray-400">
          <span class="inline-block w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></span>
          Sistema operativo
        </span>
        <span class="text-xs text-gray-600">|</span>
        <span class="text-xs text-gray-500">v2.4.1</span>
      </div>
    </div>

    {/* Grid de tarjetas estilo Nexus */}
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {/* Tarjeta: Turno actual */}
      <div class="group bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl p-5 hover:bg-white/10 hover:border-rose-500/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-rose-500/5">
        <div class="flex items-center gap-2.5 mb-3">
          <div class="p-2 bg-rose-500/10 rounded-lg">
            <Icon name="calendar" class="h-4 w-4 text-rose-400" />
          </div>
          <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Tu turno (esta semana)</h3>
        </div>
        <div class="space-y-2.5">
          <ShiftBadge shift={week.shift} />
          <div><SourceChip source={week.source} /></div>
          {nextWeek && (
            <p class="text-xs text-gray-500 pt-1 border-t border-white/5">
              Próxima semana:{" "}
              <span class="font-medium text-white">{nextWeek.shift.name}</span>
            </p>
          )}
        </div>
      </div>

      {/* Tarjeta: Horario de hoy */}
      <div class="group bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl p-5 hover:bg-white/10 hover:border-rose-500/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-rose-500/5">
        <div class="flex items-center gap-2.5 mb-3">
          <div class="p-2 bg-rose-500/10 rounded-lg">
            <Icon name="clock" class="h-4 w-4 text-rose-400" />
          </div>
          <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Horario de hoy</h3>
        </div>
        {todayEntry && todayEntry.start ? (
          <div>
            <p class="text-2xl font-bold text-white tabular-nums">
              {todayEntry.start}{" "}
              <span class="text-gray-600 font-normal">→</span>{" "}
              {todayEntry.end}
            </p>
            <p class="mt-1 text-xs text-gray-500">
              {todayEntry.day_name}, {formatShortDate(todayEntry.date)}
            </p>
            {todayEntry.is_holiday && (
              <p class="mt-1 text-xs font-medium text-purple-400">
                🎉 Festivo: {todayEntry.holiday_name}
              </p>
            )}
          </div>
        ) : (
          <div>
            <p class="text-2xl font-bold text-gray-600">Sin turno</p>
            <p class="mt-1 text-xs text-gray-500">Hoy no tienes horario asignado.</p>
            {todayEntry?.is_holiday && (
              <p class="mt-1 text-xs font-medium text-purple-400">
                🎉 Festivo: {todayEntry.holiday_name}
              </p>
            )}
          </div>
        )}
      </div>

      {/* Tarjeta: Tu semana */}
      <div class="group bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl p-5 hover:bg-white/10 hover:border-rose-500/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-rose-500/5">
        <div class="flex items-center gap-2.5 mb-3">
          <div class="p-2 bg-rose-500/10 rounded-lg">
            <Icon name="calendar" class="h-4 w-4 text-rose-400" />
          </div>
          <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Tu semana</h3>
        </div>
        <div class="flex flex-wrap gap-1.5">
          {workingDays.map((day) => {
            const isToday = day.date === today;
            const style = shiftStyle(
              day.is_holiday ? "purple" : week.shift.color,
            );
            return (
              <span
                title={`${day.day_name}: ${day.start} – ${day.end}${day.is_holiday ? " (festivo)" : ""}`}
                class:list={[
                  "flex h-11 w-11 flex-col items-center justify-center rounded-xl text-xs font-semibold text-white transition-all duration-200",
                  style.chip,
                  isToday && "ring-2 ring-rose-400/60 shadow-lg shadow-rose-500/20",
                  "hover:scale-110 hover:shadow-lg",
                ]}
              >
                <span>{dayShort[day.weekday]}</span>
                <span class="text-[10px] font-normal tabular-nums opacity-80">
                  {day.end}
                </span>
              </span>
            );
          })}
        </div>
      </div>

      {/* Tarjeta: Novedades */}
      <div class="group bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl p-5 hover:bg-white/10 hover:border-rose-500/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-rose-500/5">
        <div class="flex items-center gap-2.5 mb-3">
          <div class="p-2 bg-rose-500/10 rounded-lg">
            <Icon name="bell" class="h-4 w-4 text-rose-400" />
          </div>
          <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Novedades</h3>
          {isApprover && pendingCount > 0 && (
            <span class="ml-auto px-2 py-0.5 text-[10px] font-bold bg-rose-500/20 text-rose-400 rounded-full">
              {pendingCount}
            </span>
          )}
        </div>
        {isApprover ? (
          <div>
            <p class="text-2xl font-bold text-white">{pendingCount}</p>
            <p class="mt-1 text-xs text-gray-500">novedades pendientes de revisión.</p>
            <a
              href="/dashboard/novedades"
              class="mt-3 inline-flex items-center gap-1.5 text-xs font-medium text-rose-400 hover:text-rose-300 transition-colors group-hover:gap-2.5"
            >
              Revisar
              <svg class="w-3 h-3 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        ) : myPending > 0 ? (
          <div>
            <p class="text-2xl font-bold text-white">{myPending}</p>
            <p class="mt-1 text-xs text-gray-500">solicitudes tuyas pendientes de aprobación.</p>
            <a
              href="/dashboard/novedades"
              class="mt-3 inline-flex items-center gap-1.5 text-xs font-medium text-rose-400 hover:text-rose-300 transition-colors group-hover:gap-2.5"
            >
              Ver
              <svg class="w-3 h-3 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        ) : (
          <div>
            <p class="text-sm text-gray-400">Sin novedades pendientes.</p>
            <a
              href="/dashboard/novedades"
              class="mt-3 inline-flex items-center gap-1.5 text-xs font-medium text-rose-400 hover:text-rose-300 transition-colors group-hover:gap-2.5"
            >
              Solicitar cambio
              <svg class="w-3 h-3 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        )}
      </div>
    </div>

    {/* Botón de acción principal */}
    <div class="flex flex-wrap gap-3">
      <a
        href="/dashboard/horarios"
        class="inline-flex items-center gap-2.5 px-5 py-3 bg-gradient-to-r from-rose-500 to-rose-600 rounded-xl text-sm font-medium text-white shadow-lg shadow-rose-500/25 hover:shadow-rose-500/40 hover:-translate-y-0.5 transition-all duration-300"
      >
        <Icon name="calendar" class="h-5 w-5" />
        Ver horario semanal
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a
        href="/dashboard/novedades"
        class="inline-flex items-center gap-2 px-5 py-3 bg-white/5 border border-white/10 rounded-xl text-sm font-medium text-gray-300 hover:bg-white/10 hover:border-rose-500/20 transition-all duration-300"
      >
        <Icon name="bell" class="h-5 w-5" />
        Ver novedades
      </a>
    </div>

    {/* Footer del dashboard */}
    <div class="pt-6 border-t border-white/5 flex flex-wrap justify-between items-center gap-3">
      <div class="flex items-center gap-4 text-xs text-gray-500">
        <span>Última actualización: {new Date().toLocaleString('es-ES')}</span>
        <span class="hidden sm:inline">·</span>
        <span class="hidden sm:inline">Cluster: US-EAST-4B</span>
      </div>
      <div class="flex items-center gap-2 text-xs text-gray-600">
        <span class="inline-block w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></span>
        <span>Sync Activo</span>
      </div>
    </div>
  </div>
</DashboardLayout>