---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import FlashMessage from "../../components/FlashMessage.astro";
import ShiftBadge from "../../components/ShiftBadge.astro";
import { formatShortDate } from "../../lib/format";
import {
  fetchShifts,
  fetchUsers,
  type ShiftDefinition,
  type UserAdmin,
} from "../../services/api";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login");
if (user.role !== "ADMIN") return Astro.redirect("/dashboard");
const token = Astro.locals.token ?? "";

const PAGE_SIZE = 50;
const pageParam = Number(Astro.url.searchParams.get("page") ?? "1");
const page = Number.isInteger(pageParam) && pageParam >= 1 ? pageParam : 1;

let users: UserAdmin[] = [];
let total = 0;
let shiftCatalog: ShiftDefinition[] = [];
try {
  const result = await fetchUsers(token, { page, limit: PAGE_SIZE });
  users = result.items;
  total = result.total;
  shiftCatalog = await fetchShifts(token);
} catch {
  return Astro.redirect("/login");
}

const editParam = Number(Astro.url.searchParams.get("edit") ?? NaN);
const editing = users.find((candidate) => candidate.id === editParam) ?? null;

const ROLES = ["ADMIN", "SUPERVISOR", "EMPLOYEE"] as const;
const SHIFTS = ["SHIFT_1", "SHIFT_2", "SHIFT_3", "SHIFT_4"] as const;
const roleLabels: Record<string, string> = {
  ADMIN: "Administrador",
  SUPERVISOR: "Supervisor",
  EMPLOYEE: "Empleado",
};

const shiftInfo = (shiftId: string): ShiftDefinition =>
  shiftCatalog.find((entry) => entry.id === shiftId) ??
  ({
    id: shiftId,
    name: shiftId,
    color: "blue",
    start: "",
    end: "",
  } as ShiftDefinition);

const rank = (candidate: UserAdmin) => (candidate.role === "EMPLOYEE" ? 0 : 1);
const position = (candidate: UserAdmin) => candidate.rotation_position ?? 9999;
const sorted = [...users].sort(
  (a, b) =>
    rank(a) - rank(b) ||
    position(a) - position(b) ||
    a.name.localeCompare(b.name),
);
const activeCount = users.filter((candidate) => candidate.is_active).length;

const inputClass = `
  w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 
  text-sm text-white placeholder:text-gray-500 
  focus:border-rose-500/40 focus:outline-none focus:ring-2 focus:ring-rose-500/20 
  transition-all duration-300
  hover:border-white/20
`;
const labelClass = "block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5";

const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
---

<DashboardLayout title="Usuarios" user={user}>
  <div class="space-y-8">
    {/* Encabezado estilo Nexus */}
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-3xl font-bold text-white tracking-tight flex items-center gap-3">
          <span>Usuarios</span>
          <span class="text-sm font-normal text-gray-500 tracking-normal bg-white/5 px-3 py-1 rounded-full border border-white/5">
            {total} registrados
          </span>
        </h1>
        <p class="mt-2 text-sm text-gray-400">
          {activeCount} activos · los empleados se listan en su orden de rotación.
        </p>
      </div>
      <div class="flex items-center gap-3 px-4 py-2 bg-white/5 rounded-full border border-white/5">
        <span class="text-xs text-gray-400">Cluster</span>
        <span class="text-xs text-rose-400 font-medium">US-EAST-4B</span>
      </div>
    </div>

    <FlashMessage />

    <!-- Crear usuario - estilo Nexus -->
    <details class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl hover:border-rose-500/20 transition-all duration-300">
      <summary class="cursor-pointer list-none px-6 py-4 text-sm font-semibold text-white hover:text-rose-400 transition-colors duration-200 [&::-webkit-details-marker]:hidden flex items-center gap-2.5">
        <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Crear usuario
      </summary>
      <form method="POST" action="/api/usuarios" class="grid gap-4 border-t border-white/5 p-6 sm:grid-cols-2">
        <div>
          <label for="new-name" class={labelClass}>Nombre</label>
          <input id="new-name" name="name" required minlength="2" class={inputClass} placeholder="Nombre completo" />
        </div>
        <div>
          <label for="new-email" class={labelClass}>Correo</label>
          <input id="new-email" name="email" type="email" required class={inputClass} placeholder="usuario@empresa.com" />
        </div>
        <div>
          <label for="new-password" class={labelClass}>Contraseña <span class="font-normal lowercase text-gray-600">(mín. 8)</span></label>
          <input id="new-password" name="password" type="password" required minlength="8" class={inputClass} placeholder="••••••••" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="new-role" class={labelClass}>Rol</label>
            <select id="new-role" name="role" class={inputClass}>
              {ROLES.map((role) => (
                <option value={role} class="bg-[#0a0a0f] text-white">{roleLabels[role]}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="new-shift" class={labelClass}>Turno base</label>
            <select id="new-shift" name="shift" class={inputClass}>
              {SHIFTS.map((shift) => (
                <option value={shift} class="bg-[#0a0a0f] text-white">{shiftInfo(shift).name}</option>
              ))}
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 items-end gap-4">
          <div>
            <label for="new-position" class={labelClass}>Posición de rotación</label>
            <input id="new-position" name="rotation_position" type="number" min="1" class={inputClass} placeholder="Opcional" />
          </div>
          <label class="flex items-center gap-2 text-sm text-gray-400 cursor-pointer">
            <input type="checkbox" name="is_active" checked class="h-4 w-4 rounded border-white/10 bg-white/5 accent-rose-500" />
            Activo
          </label>
        </div>
        <div class="sm:col-span-2">
          <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 bg-gradient-to-r from-rose-500 to-rose-600 rounded-xl text-sm font-medium text-white shadow-lg shadow-rose-500/25 hover:shadow-rose-500/40 hover:-translate-y-0.5 transition-all duration-300">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Crear usuario
          </button>
        </div>
      </form>
    </details>

    <!-- Editar usuario - estilo Nexus -->
    {editing && (
      <form method="POST" action="/api/usuarios/update" class="bg-white/5 backdrop-blur-sm border border-rose-500/20 rounded-2xl p-6 hover:border-rose-500/30 transition-all duration-300">
        <input type="hidden" name="user_id" value={editing.id} />
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/5">
          <div class="flex items-center gap-2.5">
            <div class="p-1.5 bg-rose-500/10 rounded-lg">
              <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <h2 class="text-sm font-semibold text-white">Editar: {editing.name}</h2>
          </div>
          <a href="/dashboard/usuarios" class="text-xs font-medium text-gray-400 hover:text-white transition-colors duration-200">
            Cancelar ✕
          </a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <div>
            <label for="edit-name" class={labelClass}>Nombre</label>
            <input id="edit-name" name="name" value={editing.name} minlength="2" class={inputClass} />
          </div>
          <div>
            <label for="edit-email" class={labelClass}>Correo</label>
            <input id="edit-email" name="email" type="email" value={editing.email} class={inputClass} />
          </div>
          <div>
            <label for="edit-password" class={labelClass}>Nueva contraseña <span class="font-normal lowercase text-gray-600">(opcional)</span></label>
            <input id="edit-password" name="password" type="password" minlength="8" class={inputClass} placeholder="Dejar vacío para no cambiar" />
          </div>
          <div>
            <label for="edit-role" class={labelClass}>Rol</label>
            <select id="edit-role" name="role" class={inputClass}>
              {ROLES.map((role) => (
                <option value={role} selected={role === editing.role} class="bg-[#0a0a0f] text-white">
                  {roleLabels[role]}
                </option>
              ))}
            </select>
          </div>
          <div>
            <label for="edit-shift" class={labelClass}>Turno base</label>
            <select id="edit-shift" name="shift" class={inputClass}>
              {SHIFTS.map((shift) => (
                <option value={shift} selected={shift === editing.shift} class="bg-[#0a0a0f] text-white">
                  {shiftInfo(shift).name}
                </option>
              ))}
            </select>
          </div>
          <div>
            <label for="edit-position" class={labelClass}>Posición de rotación</label>
            <input id="edit-position" name="rotation_position" type="number" min="1" value={editing.rotation_position ?? ""} class={inputClass} />
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-4 mt-4 pt-3 border-t border-white/5">
          <input type="hidden" name="has_active" value="1" />
          <label class="flex items-center gap-2 text-sm text-gray-400 cursor-pointer">
            <input type="checkbox" name="is_active" checked={editing.is_active} class="h-4 w-4 rounded border-white/10 bg-white/5 accent-rose-500" />
            Cuenta activa
          </label>
          <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 bg-gradient-to-r from-rose-500 to-rose-600 rounded-xl text-sm font-medium text-white shadow-lg shadow-rose-500/25 hover:shadow-rose-500/40 hover:-translate-y-0.5 transition-all duration-300">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Guardar cambios
          </button>
        </div>
      </form>
    )}

    <!-- Tabla de usuarios - estilo Nexus -->
    <div class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl overflow-hidden hover:border-rose-500/20 transition-all duration-300">
      <div class="p-4 border-b border-white/5 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="p-1.5 bg-rose-500/10 rounded-lg">
            <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">Lista de usuarios</span>
        </div>
        <span class="text-[10px] text-gray-500 bg-white/5 px-2 py-0.5 rounded-full border border-white/5">
          {activeCount} activos
        </span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[860px] text-sm">
          <thead>
            <tr class="border-b border-white/5 text-left text-xs uppercase tracking-wider text-gray-400">
              <th class="px-4 py-3 font-semibold">Usuario</th>
              <th class="px-4 py-3 font-semibold">Rol</th>
              <th class="px-4 py-3 font-semibold">Turno base</th>
              <th class="px-4 py-3 font-semibold">Rotación</th>
              <th class="px-4 py-3 font-semibold">Estado</th>
              <th class="px-4 py-3 font-semibold">Desde</th>
              <th class="px-4 py-3 font-semibold text-right">Acciones</th>
            </tr>
          </thead>
          <tbody>
            {sorted.map((candidate) => (
              <tr
                class:list={[
                  "border-b border-white/5 last:border-b-0 hover:bg-white/5 transition-colors duration-200",
                  !candidate.is_active && "opacity-50",
                ]}
              >
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2.5">
                    <div class="flex-shrink-0 h-8 w-8 rounded-full bg-gradient-to-r from-rose-500 to-rose-600 flex items-center justify-center text-xs font-bold text-white shadow-lg shadow-rose-500/20">
                      {candidate.name.charAt(0).toUpperCase()}
                    </div>
                    <div>
                      <div class="font-medium text-white text-sm">
                        {candidate.name}
                        {candidate.id === user.id && (
                          <span class="ml-1.5 text-[10px] text-gray-500">(tú)</span>
                        )}
                      </div>
                      <div class="text-xs text-gray-500">{candidate.email}</div>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3 text-gray-400 text-xs">
                  {roleLabels[candidate.role]}
                </td>
                <td class="px-4 py-3">
                  <ShiftBadge shift={{
                    ...shiftInfo(candidate.shift),
                    id: candidate.shift as (typeof SHIFTS)[number],
                  }} size="sm" />
                </td>
                <td class="px-4 py-3 tabular-nums text-gray-500 text-xs">
                  {candidate.role === "EMPLOYEE"
                    ? (candidate.rotation_position ?? "auto")
                    : "—"}
                </td>
                <td class="px-4 py-3">
                  {candidate.is_active ? (
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-[10px] font-medium text-emerald-400 border border-emerald-500/20">
                      <span class="inline-block w-1 h-1 bg-emerald-400 rounded-full"></span>
                      Activo
                    </span>
                  ) : (
                    <span class="inline-flex rounded-full bg-gray-500/10 px-2.5 py-0.5 text-[10px] font-medium text-gray-400 border border-gray-500/20">
                      Inactivo
                    </span>
                  )}
                </td>
                <td class="px-4 py-3 text-xs tabular-nums text-gray-500">
                  {formatShortDate(candidate.created_at.slice(0, 10))}
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-right">
                  <a href={`/dashboard/usuarios?edit=${candidate.id}`} class="text-xs font-medium text-rose-400 hover:text-rose-300 transition-colors duration-200 hover:underline">
                    Editar
                  </a>
                  {candidate.id !== user.id && (
                    <form method="POST" action="/api/usuarios/update" class="ml-3 inline">
                      <input type="hidden" name="user_id" value={candidate.id} />
                      <input type="hidden" name="has_active" value="1" />
                      {candidate.is_active ? (
                        <button type="submit" class="text-xs font-medium text-red-400 hover:text-red-300 transition-colors duration-200 hover:underline">
                          Desactivar
                        </button>
                      ) : (
                        <>
                          <input type="hidden" name="is_active" value="1" />
                          <button type="submit" class="text-xs font-medium text-emerald-400 hover:text-emerald-300 transition-colors duration-200 hover:underline">
                            Activar
                          </button>
                        </>
                      )}
                    </form>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    {/* Paginación - estilo Nexus */}
    {pages > 1 && (
      <div class="flex items-center justify-between bg-white/5 border border-white/5 rounded-xl px-4 py-3">
        {page > 1 ? (
          <a href={`/dashboard/usuarios?page=${page - 1}`} class="inline-flex items-center gap-1.5 text-sm font-medium text-rose-400 hover:text-rose-300 transition-colors duration-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Anterior
          </a>
        ) : <span></span>}
        <span class="text-sm text-gray-500">Página {page} de {pages}</span>
        {page < pages ? (
          <a href={`/dashboard/usuarios?page=${page + 1}`} class="inline-flex items-center gap-1.5 text-sm font-medium text-rose-400 hover:text-rose-300 transition-colors duration-200">
            Siguiente
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ) : <span></span>}
      </div>
    )}

    {/* Footer informativo */}
    <div class="pt-4 border-t border-white/5 flex flex-wrap justify-between items-center gap-3">
      <div class="flex items-center gap-4 text-xs text-gray-500">
        <span>Última actualización: {new Date().toLocaleString('es-ES')}</span>
        <span class="hidden sm:inline">·</span>
        <span class="hidden sm:inline">Cluster: US-EAST-4B</span>
      </div>
      <div class="flex items-center gap-2 text-xs text-gray-600">
        <span class="inline-block w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></span>
        <span>Datos sincronizados</span>
      </div>
    </div>

    <p class="text-xs text-gray-500 bg-white/5 border border-white/5 rounded-xl px-4 py-3">
      <span class="text-gray-600">ℹ️</span> La posición de rotación define el orden del ciclo de turnos (T1→T2→T3→T4): menor posición entra antes en el ciclo. Desactivar es un borrado lógico: se conserva el histórico de novedades y el usuario deja de rotar.
    </p>
  </div>
</DashboardLayout>

<style>
  select option {
    background-color: #0a0a0f;
    color: white;
  }
</style>