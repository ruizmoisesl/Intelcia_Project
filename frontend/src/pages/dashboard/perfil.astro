---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import FlashMessage from "../../components/FlashMessage.astro";
import Icon from "../../components/Icon.astro";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login");
---

<DashboardLayout title="Perfil" user={user}>
  <div class="mx-auto max-w-2xl space-y-8">
    {/* Encabezado de perfil estilo Nexus */}
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-white tracking-tight">
          Mi perfil
        </h1>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-2.5 px-3 py-1.5 bg-white/5 rounded-full border border-white/5">
            <div class="w-6 h-6 rounded-full bg-gradient-to-r from-rose-500 to-rose-600 flex items-center justify-center text-xs font-bold text-white">
              {user.name.charAt(0).toUpperCase()}
            </div>
            <span class="text-sm text-white font-medium">{user.name}</span>
          </div>
          <span class="text-sm text-gray-400">{user.email}</span>
          <span class="px-2 py-0.5 text-[10px] font-medium bg-rose-500/20 text-rose-400 rounded-full uppercase tracking-wider">
            {user.role}
          </span>
        </div>
      </div>
      <div class="flex items-center gap-2 text-xs text-gray-500">
        <span class="inline-block w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></span>
        <span>Perfil activo</span>
      </div>
    </div>

    <FlashMessage />

    {/* Formulario de cambio de contraseña estilo Nexus */}
    <div class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl p-6 hover:border-rose-500/20 transition-all duration-300">
      <div class="flex items-center gap-3 mb-6 pb-4 border-b border-white/5">
        <div class="p-2 bg-rose-500/10 rounded-lg">
          <Icon name="settings" class="h-5 w-5 text-rose-400" />
        </div>
        <div>
          <h2 class="text-sm font-semibold text-white">Cambiar contraseña</h2>
          <p class="text-xs text-gray-400 mt-0.5">Actualiza tu contraseña de acceso al sistema</p>
        </div>
      </div>

      <form method="POST" action="/api/perfil/password" class="space-y-5">
        {/* Contraseña actual */}
        <div>
          <label for="current" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">
            Contraseña actual
          </label>
          <input
            id="current" 
            name="current_password" 
            type="password" 
            required
            autocomplete="current-password"
            placeholder="••••••••"
            class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white placeholder:text-gray-600 focus:border-rose-500/40 focus:outline-none focus:ring-2 focus:ring-rose-500/20 transition-all duration-300"
          />
        </div>

        {/* Nueva contraseña y confirmación */}
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="new" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">
              Nueva contraseña <span class="font-normal lowercase text-gray-600">(mín. 8)</span>
            </label>
            <input
              id="new" 
              name="new_password" 
              type="password" 
              required 
              minlength="8"
              autocomplete="new-password"
              placeholder="••••••••"
              class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white placeholder:text-gray-600 focus:border-rose-500/40 focus:outline-none focus:ring-2 focus:ring-rose-500/20 transition-all duration-300"
            />
          </div>
          <div>
            <label for="confirm" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">
              Confirmar nueva
            </label>
            <input
              id="confirm" 
              name="confirm_password" 
              type="password" 
              required 
              minlength="8"
              autocomplete="new-password"
              placeholder="••••••••"
              class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white placeholder:text-gray-600 focus:border-rose-500/40 focus:outline-none focus:ring-2 focus:ring-rose-500/20 transition-all duration-300"
            />
          </div>
        </div>

        {/* Botón de actualización */}
        <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
          <button
            type="submit"
            class="inline-flex items-center gap-2.5 px-6 py-2.5 bg-gradient-to-r from-rose-500 to-rose-600 rounded-xl text-sm font-medium text-white shadow-lg shadow-rose-500/25 hover:shadow-rose-500/40 hover:-translate-y-0.5 transition-all duration-300"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            Actualizar contraseña
          </button>
          <p class="text-xs text-gray-500">
            <span class="text-gray-600">ℹ️</span> Tu sesión actual sigue válida
          </p>
        </div>
      </form>
    </div>

    {/* Información adicional de seguridad */}
    <div class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl p-5">
      <div class="flex items-start gap-3">
        <div class="p-1.5 bg-emerald-500/10 rounded-lg mt-0.5">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <p class="text-xs font-semibold text-white">Seguridad de la cuenta</p>
          <p class="text-xs text-gray-400 mt-0.5">
            Los próximos inicios de sesión usarán la nueva contraseña. 
            <span class="text-gray-500">· ISO/IEC 27001</span>
          </p>
        </div>
      </div>
    </div>

    {/* Footer del perfil */}
    <div class="pt-4 border-t border-white/5 flex flex-wrap justify-between items-center gap-3">
      <div class="flex items-center gap-4 text-xs text-gray-500">
        <span>Último acceso: {new Date().toLocaleString('es-ES')}</span>
        <span class="hidden sm:inline">·</span>
        <span class="hidden sm:inline">Cluster: US-EAST-4B</span>
      </div>
      <div class="flex items-center gap-2 text-xs text-gray-600">
        <span class="inline-block w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></span>
        <span>Sesión segura</span>
      </div>
    </div>
  </div>
</DashboardLayout>