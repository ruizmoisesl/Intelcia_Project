---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import RotationPreview from "../../components/RotationPreview.astro";
import ShiftBadge from "../../components/ShiftBadge.astro";
import SourceChip from "../../components/SourceChip.astro";
import WeekNav from "../../components/WeekNav.astro";
import WeeklySchedule from "../../components/WeeklySchedule.astro";
import {
  fetchRotationPreview,
  fetchShifts,
  fetchWeekSchedule,
  type RotationEntry,
  type ShiftDefinition,
  type WeekSchedule,
} from "../../services/api";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login");
const token = Astro.locals.token ?? "";

const weekParam = Astro.url.searchParams.get("week");
const requestedWeek = weekParam && /^\d{4}-\d{2}-\d{2}$/.test(weekParam) ? weekParam : undefined;

let week: WeekSchedule;
let shifts: ShiftDefinition[];
let rotation: { weeks: RotationEntry[] };
try {
  week = await fetchWeekSchedule(token, requestedWeek);
  shifts = await fetchShifts(token);
  rotation = await fetchRotationPreview(token, 6);
} catch {
  return Astro.redirect("/login"); // sesión caducada o backend no disponible
}

const today = week.today;
const upcoming = rotation.weeks.filter((entry) => entry.week_start > week.week_start).slice(0, 4);
const addDaysIso = (date: string, days: number) => {
  const value = new Date(`${date}T00:00:00Z`);
  value.setUTCDate(value.getUTCDate() + days);
  return value.toISOString().slice(0, 10);
};
const formatRange = (start: string, end: string) => {
  const format = (date: string) =>
    new Intl.DateTimeFormat("es-ES", { day: "numeric", month: "long", timeZone: "UTC" }).format(
      new Date(`${date}T00:00:00Z`),
    );
  return `${format(start)} - ${format(end)}`;
};
const range = formatRange(week.week_start, addDaysIso(week.week_start, 6));
---

<DashboardLayout title="Horarios" user={user}>
  <div class="space-y-8">
    {/* Encabezado estilo Nexus */}
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-white tracking-tight">
          Mi horario
          <span class="ml-3 text-sm font-normal text-gray-500 tracking-normal">
            · Semana del {range}
          </span>
        </h1>
        <div class="mt-2 flex flex-wrap items-center gap-2.5">
          <ShiftBadge shift={week.shift} />
          <span class="text-gray-600 text-xs">|</span>
          <SourceChip source={week.source} />
          <span class="ml-2 text-xs text-gray-500 flex items-center gap-1.5">
            <span class="inline-block w-1.5 h-1.5 bg-emerald-400 rounded-full"></span>
            Actualizado
          </span>
        </div>
      </div>
      <div class="flex items-center gap-3 px-4 py-2 bg-white/5 rounded-full border border-white/5">
        <span class="text-xs text-gray-400">Semana actual</span>
        <span class="text-xs text-rose-400 font-medium">{week.week_start}</span>
      </div>
    </div>

    {/* Navegador de semanas estilo Nexus */}
    <div class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl p-4 hover:bg-white/8 transition-all duration-300">
      <WeekNav basePath="/dashboard/horarios" weekStart={week.week_start} today={today} />
    </div>

    {/* Calendario semanal */}
    <div class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl overflow-hidden hover:border-rose-500/20 transition-all duration-300">
      <div class="p-4 border-b border-white/5">
        <div class="flex items-center gap-2.5">
          <div class="p-1.5 bg-rose-500/10 rounded-lg">
            <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">Calendario semanal</span>
        </div>
      </div>
      <div class="p-4">
        <WeeklySchedule week={week} shifts={shifts} today={today} />
      </div>
    </div>

    {/* Rotación de próximas semanas */}
    {upcoming.length > 0 && (
      <div class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl hover:border-rose-500/20 transition-all duration-300">
        <div class="p-4 border-b border-white/5">
          <div class="flex items-center gap-2.5">
            <div class="p-1.5 bg-rose-500/10 rounded-lg">
              <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            </div>
            <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">Próximas semanas</span>
            <span class="ml-auto text-xs text-gray-500">{upcoming.length} semanas disponibles</span>
          </div>
        </div>
        <div class="p-4">
          <RotationPreview entries={upcoming} />
        </div>
      </div>
    )}

    {/* Footer con información adicional */}
    <div class="pt-4 border-t border-white/5 flex flex-wrap justify-between items-center gap-3">
      <div class="flex items-center gap-4 text-xs text-gray-500">
        <span>Turno actual: <span class="text-white font-medium">{week.shift.name}</span></span>
        <span class="hidden sm:inline">·</span>
        <span class="hidden sm:inline">Origen: {week.source}</span>
      </div>
      <div class="flex items-center gap-2 text-xs text-gray-600">
        <span class="inline-block w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></span>
        <span>Datos sincronizados</span>
        <span class="text-gray-700">·</span>
        <span>{new Date().toLocaleTimeString('es-ES', { hour12: false })}</span>
      </div>
    </div>
  </div>
</DashboardLayout>