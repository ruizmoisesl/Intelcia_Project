---
interface Props {
  source: string;
  size?: "sm" | "md";
}

const { source, size = "md" } = Astro.props;

const sizeClasses = {
  sm: "text-[10px] px-2 py-0.5 gap-1",
  md: "text-[11px] px-3 py-1 gap-1.5"
};

const LABELS: Record<string, { label: string; cls: string; icon: string }> = {
  ROTATION: { 
    label: "Rotación semanal", 
    cls: "bg-amber-500/10 text-amber-400 border-amber-500/20",
    icon: "⟳"
  },
  FIXED: { 
    label: "Turno fijo", 
    cls: "bg-blue-500/10 text-blue-400 border-blue-500/20",
    icon: "◆"
  },
  APPROVED_CHANGE: { 
    label: "Cambio aprobado", 
    cls: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
    icon: "✓"
  },
};

const info = LABELS[source] ?? { 
  label: source, 
  cls: "bg-gray-500/10 text-gray-400 border-gray-500/20",
  icon: "●"
};
---

<span class={`
  inline-flex items-center rounded-full font-medium border
  ${sizeClasses[size]}
  ${info.cls}
  transition-all duration-200
  hover:scale-105 hover:shadow-lg
`}>
  <span class="text-[13px] leading-none">{info.icon}</span>
  {info.label}
</span>