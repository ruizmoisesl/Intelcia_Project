---
import type { ShiftDefinition } from "../services/api";

interface Props {
  shifts: ShiftDefinition[];
  next?: string;
  /** «Hoy» según el backend: límite inferior del selector de semana. */
  today?: string | null;
}

const { shifts, next = "/dashboard/novedades", today = null } = Astro.props;
const selectable = shifts.filter((shift) => shift.id !== "HOLIDAY");

const inputClass = `
  w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 
  text-sm text-white placeholder:text-gray-500 
  focus:border-rose-500/40 focus:outline-none focus:ring-2 focus:ring-rose-500/20 
  transition-all duration-300
  hover:border-white/20
`;
const labelClass = "block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5";
---

<form method="POST" action="/api/novedades" class="space-y-5">
  <input type="hidden" name="next" value={next} />

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="novedad-week" class={labelClass}>Semana</label>
      <input 
        id="novedad-week" 
        type="date" 
        name="week_start" 
        min={today ?? undefined} 
        required 
        class={inputClass} 
      />
      <p class="mt-1.5 text-xs text-gray-500 flex items-center gap-1.5">
        <svg class="w-3 h-3 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Cualquier día de la semana vale: se toma su lunes.
      </p>
    </div>
    <div>
      <label for="novedad-shift" class={labelClass}>Turno solicitado</label>
      <select id="novedad-shift" name="requested_shift" required class={inputClass}>
        <option value="" disabled selected>Seleccionar turno</option>
        {selectable.map((shift) => (
          <option value={shift.id} class="bg-[#0a0a0f] text-white">
            {shift.name} · {shift.start}–{shift.end}
          </option>
        ))}
      </select>
    </div>
  </div>

  <div>
    <label for="novedad-reason" class={labelClass}>Motivo</label>
    <textarea
      id="novedad-reason"
      name="reason"
      rows="3"
      maxlength="500"
      required
      placeholder="Ej.: cita médica, cuidado familiar, cambio acordado con mi supervisor…"
      class={inputClass}
    ></textarea>
    <p class="mt-1.5 text-xs text-gray-500 text-right">
      <span class="text-gray-600" id="charCount">0</span>/500 caracteres
    </p>
  </div>

  <button
    type="submit"
    class="inline-flex items-center gap-2.5 px-6 py-2.5 bg-gradient-to-r from-rose-500 to-rose-600 rounded-xl text-sm font-medium text-white shadow-lg shadow-rose-500/25 hover:shadow-rose-500/40 hover:-translate-y-0.5 transition-all duration-300"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
    </svg>
    Enviar solicitud
  </button>
</form>

<script>
  // Contador de caracteres en tiempo real
  document.addEventListener('DOMContentLoaded', () => {
    const textarea = document.getElementById('novedad-reason') as HTMLTextAreaElement | null;
    const charCount = document.getElementById('charCount') as HTMLElement | null;

    if (textarea && charCount) {
      textarea.addEventListener('input', () => {
        const count = textarea.value.length;
        charCount.textContent = String(count);
      });
    }
  });
</script>

<style>
  select option {
    background-color: #0a0a0f;
    color: white;
  }
  
  select option:disabled {
    color: #666;
  }
  
  input[type="date"]::-webkit-calendar-picker-indicator {
    filter: invert(0.5);
    cursor: pointer;
  }
  
  input[type="date"]::-webkit-calendar-picker-indicator:hover {
    filter: invert(0.8);
  }
</style>