<!-- TaskStatusBadge.astro -->
---
interface Props { status: string; }
const { status } = Astro.props;
const STATUS: Record<string, { label: string; cls: string }> = {
  PENDING: { label: "Pendiente", cls: "bg-amber-100 text-amber-800 dark:bg-amber-500/15 dark:text-amber-300" },
  IN_PROGRESS: { label: "En proceso", cls: "bg-sky-100 text-sky-800 dark:bg-sky-500/15 dark:text-sky-300" },
  DONE: { label: "Completada", cls: "bg-emerald-100 text-emerald-800 dark:bg-emerald-500/15 dark:text-emerald-300" },
};
const info = STATUS[status] ?? { label: status, cls: "bg-slate-100 text-slate-600" };
---
<span class={`inline-flex rounded-full px-2.5 py-0.5 text-[11px] font-medium ${info.cls}`}>{info.label}</span>