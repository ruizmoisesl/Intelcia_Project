---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nexus Central · Bienvenido</title>
  </head>
  <body>
    <div id="container">
      <!-- Fondo con efecto Nexus -->
      <div id="background-overlay"></div>
      <img id="background" src={background.src} alt="" fetchpriority="high" />
      
      <!-- Grid decorativo Nexus -->
      <div id="grid-overlay"></div>
      
      <main>
        <section id="hero">
          <div class="brand-container">
            <div class="logo-wrapper">
              <img src={astroLogo.src} width="48" height="48" alt="Nexus Central" />
              <div class="brand-text">
                <span class="brand-title">Nexus Central</span>
                <span class="brand-subtitle">Enterprise Management Core</span>
              </div>
            </div>
            
            <div class="status-badge">
              <span class="status-dot"></span>
              <span>System Online</span>
            </div>
          </div>

          <h1>
            <span class="gradient-text">Bienvenido a Nexus Central</span>
            <span class="subtitle-text">Plataforma centralizada de gestión & recursos</span>
          </h1>
          
          <p class="description">
            Acceso unificado para el ecosistema productivo corporativo, herramientas de control 
            operacional y telemetría de negocio.
          </p>

          <div id="links">
            <a class="button primary" href="/dashboard">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1m-2 0h2" />
              </svg>
              Acceder al Portal
            </a>
            <a class="button secondary" href="https://docs.astro.build">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              Documentación
            </a>
            <a class="button tertiary" href="https://astro.build/chat">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 127.14 96.36" class="w-5 h-5">
                <path fill="currentColor" d="M107.7 8.07A105.15 105.15 0 0 0 81.47 0a72.06 72.06 0 0 0-3.36 6.83 97.68 97.68 0 0 0-29.11 0A72.37 72.37 0 0 0 45.64 0a105.89 105.89 0 0 0-26.25 8.09C2.79 32.65-1.71 56.6.54 80.21a105.73 105.73 0 0 0 32.17 16.15 77.7 77.7 0 0 0 6.89-11.11 68.42 68.42 0 0 1-10.85-5.18c.91-.66 1.8-1.34 2.66-2a75.57 75.57 0 0 0 64.32 0c.87.71 1.76 1.39 2.66 2a68.68 68.68 0 0 1-10.87 5.19 77 77 0 0 0 6.89 11.1 105.25 105.25 0 0 0 32.19-16.14c2.64-27.38-4.51-51.11-18.9-72.15ZM42.45 65.69C36.18 65.69 31 60 31 53s5-12.74 11.43-12.74S54 46 53.89 53s-5.05 12.69-11.44 12.69Zm42.24 0C78.41 65.69 73.25 60 73.25 53s5-12.74 11.44-12.74S96.23 46 96.12 53s-5.04 12.69-11.43 12.69Z" />
              </svg>
              Comunidad
            </a>
          </div>

          <div class="services-grid">
            <span class="service-tag">Google Drive</span>
            <span class="service-tag">Workspace Mail</span>
            <span class="service-tag">Calendario API</span>
            <span class="service-tag">Inventario IT</span>
            <span class="service-tag">Directivas SOX</span>
          </div>

          <div class="security-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
            <span>POLÍTICAS ZERO-TRUST · ISO/IEC 27001 · Auditoría continua</span>
          </div>
        </section>
      </main>

      <div id="news" class="box">
        <div class="news-icon">
          <svg width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M24.667 12c1.333 1.414 2 3.192 2 5.334 0 4.62-4.934 5.7-7.334 12C18.444 28.567 18 27.456 18 26c0-4.642 6.667-7.053 6.667-14Zm-5.334-5.333c1.6 1.65 2.4 3.43 2.4 5.333 0 6.602-8.06 7.59-6.4 17.334C13.111 27.787 12 25.564 12 22.666c0-4.434 7.333-8 7.333-16Zm-6-5.333C15.111 3.555 16 5.556 16 7.333c0 8.333-11.333 10.962-5.333 22-3.488-.774-6-4-6-8 0-8.667 8.666-10 8.666-20Z" fill="currentColor"/>
          </svg>
        </div>
        <div class="news-content">
          <h2>What's New in Nexus Central 2.4?</h2>
          <p>Rust-powered compiler, advanced routing, AI agent support, and more!</p>
        </div>
      </div>
    </div>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background: #0a0a0f;
        min-height: 100vh;
        color: white;
        overflow: hidden;
      }

      #container {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      /* Fondo con efecto */
      #background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        filter: blur(100px);
        opacity: 0.3;
      }

      #background-overlay {
        position: fixed;
        inset: 0;
        z-index: 1;
        background: 
          radial-gradient(ellipse at 20% 50%, rgba(232, 62, 140, 0.08) 0%, transparent 60%),
          radial-gradient(ellipse at 80% 50%, rgba(232, 62, 140, 0.05) 0%, transparent 60%),
          radial-gradient(ellipse at 50% 0%, rgba(232, 62, 140, 0.03) 0%, transparent 50%);
        pointer-events: none;
      }

      #grid-overlay {
        position: fixed;
        inset: 0;
        z-index: 1;
        background-image: 
          linear-gradient(rgba(232, 62, 140, 0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(232, 62, 140, 0.03) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
      }

      main {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 900px;
        display: flex;
        justify-content: center;
      }

      #hero {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1.5rem;
        padding: 2rem;
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(20px);
        border-radius: 2rem;
        border: 1px solid rgba(255, 255, 255, 0.06);
        box-shadow: 0 40px 120px rgba(0, 0, 0, 0.6);
        width: 100%;
      }

      .brand-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .logo-wrapper {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .logo-wrapper img {
        width: 48px;
        height: 48px;
        filter: brightness(0) invert(1);
      }

      .brand-text {
        display: flex;
        flex-direction: column;
      }

      .brand-title {
        font-size: 20px;
        font-weight: 700;
        color: white;
        letter-spacing: -0.5px;
      }

      .brand-subtitle {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.3);
        font-weight: 500;
        letter-spacing: 2px;
        text-transform: uppercase;
      }

      .status-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.8rem;
        background: rgba(34, 197, 94, 0.1);
        border: 1px solid rgba(34, 197, 94, 0.2);
        border-radius: 100px;
        font-size: 10px;
        color: #4ade80;
        font-weight: 500;
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }

      .status-dot {
        width: 6px;
        height: 6px;
        background: #22c55e;
        border-radius: 50%;
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
      }

      h1 {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .gradient-text {
        font-size: 36px;
        font-weight: 700;
        background: linear-gradient(135deg, #e83e8c 0%, #d63384 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: -1px;
      }

      .subtitle-text {
        font-size: 20px;
        font-weight: 400;
        color: rgba(255, 255, 255, 0.4);
        letter-spacing: -0.3px;
      }

      .description {
        font-size: 15px;
        color: rgba(255, 255, 255, 0.4);
        line-height: 1.6;
        max-width: 600px;
        margin: 0;
      }

      #links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        width: 100%;
      }

      .button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.65rem 1.25rem;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.3s ease;
        border: 1px solid transparent;
      }

      .button.primary {
        background: linear-gradient(135deg, #e83e8c 0%, #d63384 100%);
        color: white;
        box-shadow: 0 8px 24px rgba(232, 62, 140, 0.25);
      }

      .button.primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 32px rgba(232, 62, 140, 0.35);
      }

      .button.secondary {
        background: rgba(255, 255, 255, 0.05);
        color: rgba(255, 255, 255, 0.6);
        border-color: rgba(255, 255, 255, 0.08);
      }

      .button.secondary:hover {
        background: rgba(255, 255, 255, 0.08);
        color: white;
        border-color: rgba(232, 62, 140, 0.2);
      }

      .button.tertiary {
        background: rgba(255, 255, 255, 0.05);
        color: rgba(255, 255, 255, 0.6);
        border-color: rgba(255, 255, 255, 0.08);
      }

      .button.tertiary:hover {
        background: rgba(255, 255, 255, 0.08);
        color: white;
        border-color: rgba(232, 62, 140, 0.2);
      }

      .button svg {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
      }

      .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 0.5rem;
        width: 100%;
        max-width: 500px;
      }

      .service-tag {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 8px;
        padding: 0.4rem 0.75rem;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.5);
        font-weight: 500;
        text-align: center;
        letter-spacing: 0.3px;
        transition: all 0.3s ease;
      }

      .service-tag:hover {
        background: rgba(232, 62, 140, 0.08);
        border-color: rgba(232, 62, 140, 0.2);
        color: rgba(255, 255, 255, 0.8);
      }

      .security-badge {
        padding: 0.6rem 1rem;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.04);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        width: 100%;
        max-width: 500px;
      }

      .security-badge svg {
        flex-shrink: 0;
        opacity: 0.3;
        color: white;
      }

      .security-badge span {
        font-size: 10px;
        color: rgba(255, 255, 255, 0.25);
        line-height: 1.4;
        font-weight: 400;
        letter-spacing: 0.3px;
      }

      #news {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        max-width: 320px;
        padding: 1.25rem;
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(20px);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        text-decoration: none;
        transition: all 0.3s ease;
        z-index: 10;
        display: flex;
        gap: 1rem;
        align-items: flex-start;
      }

      #news:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(232, 62, 140, 0.2);
        transform: translateY(-4px);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
      }

      .news-icon {
        flex-shrink: 0;
        color: #e83e8c;
        opacity: 0.6;
      }

      .news-content h2 {
        font-size: 14px;
        font-weight: 600;
        color: white;
        margin: 0 0 0.25rem 0;
        line-height: 1.3;
      }

      .news-content p {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.4);
        margin: 0;
        line-height: 1.4;
      }

      @media (max-width: 768px) {
        #container {
          padding: 1rem;
        }

        #hero {
          padding: 1.5rem;
          gap: 1rem;
        }

        .brand-container {
          flex-direction: column;
          align-items: flex-start;
        }

        .gradient-text {
          font-size: 28px;
        }

        .subtitle-text {
          font-size: 16px;
        }

        #links {
          flex-direction: column;
        }

        .button {
          justify-content: center;
          padding: 0.8rem 1rem;
        }

        #news {
          position: static;
          max-width: 100%;
          margin-top: 1rem;
        }

        .services-grid {
          grid-template-columns: repeat(3, 1fr);
        }

        .security-badge {
          flex-wrap: wrap;
        }
      }

      @media (max-width: 480px) {
        .gradient-text {
          font-size: 24px;
        }

        .services-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .brand-title {
          font-size: 18px;
        }

        .logo-wrapper img {
          width: 36px;
          height: 36px;
        }
      }

      @media (max-height: 700px) {
        #hero {
          gap: 0.75rem;
          padding: 1.25rem;
        }

        .gradient-text {
          font-size: 28px;
        }

        .subtitle-text {
          font-size: 16px;
        }
      }
    </style>
  </body>
</html>