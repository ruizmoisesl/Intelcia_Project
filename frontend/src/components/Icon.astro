interface Props {
  name: IconName | string;
  class?: string;
  strokeWidth?: number;
}

const { 
  name, 
  class: className = "h-5 w-5",
  strokeWidth = 1.7 
} = Astro.props;
const iconMarkup = icons[name] ?? icons.shield;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={icons[name] || icons.shield}
/>