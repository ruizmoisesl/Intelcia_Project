---
import { addDaysIso, formatRange } from "../lib/format";
import type { ScheduleChange } from "../services/api";
import ShiftBadge from "./ShiftBadge.astro";

interface Props {
  change: ScheduleChange;
}

const { change } = Astro.props;
const weekEnd = addDaysIso(change.week_start, 6);
---

<article class="group bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl p-5 hover:bg-white/10 hover:border-rose-500/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-rose-500/5">
  {/* Encabezado */}
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2.5">
        <div class="flex-shrink-0 h-8 w-8 rounded-full bg-gradient-to-r from-rose-500 to-rose-600 flex items-center justify-center text-xs font-bold text-white shadow-lg shadow-rose-500/20">
          {change.user.name.charAt(0).toUpperCase()}
        </div>
        <div>
          <h3 class="font-semibold text-white">{change.user.name}</h3>
          <p class="text-xs text-gray-400 flex items-center gap-1.5">
            <svg class="w-3 h-3 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Semana del {formatRange(change.week_start, weekEnd)}
          </p>
        </div>
      </div>
    </div>
    <span class="flex-shrink-0 text-xs text-gray-500 bg-white/5 px-3 py-1 rounded-full border border-white/5">
      Solicitada por {change.requested_by.name}
    </span>
  </div>

  {/* Cambio de turno */}
  <div class="mt-4 flex flex-wrap items-center gap-3 p-3 bg-white/5 rounded-xl border border-white/5">
    <div class="flex items-center gap-2">
      <span class="text-xs text-gray-400 font-medium">Actual</span>
      {change.current_shift && <ShiftBadge shift={change.current_shift} />}
    </div>
    <span class="text-gray-600 text-lg">→</span>
    <div class="flex items-center gap-2">
      <span class="text-xs text-gray-400 font-medium">Solicitado</span>
      <ShiftBadge shift={change.requested_shift} />
    </div>
  </div>

  {/* Motivo */}
  {change.reason && (
    <blockquote class="mt-3 border-l-2 border-rose-500/30 pl-3 text-sm text-gray-300 italic">
      “{change.reason}”
    </blockquote>
  )}

  {/* Formulario de revisión */}
  <form method="POST" action="/api/novedades/review" class="mt-4 flex flex-col gap-3 sm:flex-row items-start sm:items-center">
    <input type="hidden" name="change_id" value={change.id} />
    <input type="hidden" name="next" value="/dashboard/novedades" />
    
    <div class="flex-1 w-full sm:w-auto">
      <input
        type="text"
        name="note"
        maxlength="500"
        placeholder="Nota para el empleado (opcional)"
        class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white placeholder:text-gray-500 focus:border-rose-500/40 focus:outline-none focus:ring-2 focus:ring-rose-500/20 transition-all duration-300"
      />
    </div>
    
    <div class="flex gap-2 w-full sm:w-auto">
      <button
        type="submit"
        name="decision"
        value="approve"
        class="flex-1 sm:flex-none inline-flex items-center justify-center gap-1.5 px-5 py-2.5 bg-gradient-to-r from-emerald-500 to-emerald-600 rounded-xl text-sm font-medium text-white shadow-lg shadow-emerald-500/25 hover:shadow-emerald-500/40 hover:-translate-y-0.5 transition-all duration-300"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
        Aprobar
      </button>
      <button
        type="submit"
        name="decision"
        value="reject"
        class="flex-1 sm:flex-none inline-flex items-center justify-center gap-1.5 px-5 py-2.5 bg-gradient-to-r from-red-500 to-red-600 rounded-xl text-sm font-medium text-white shadow-lg shadow-red-500/25 hover:shadow-red-500/40 hover:-translate-y-0.5 transition-all duration-300"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
        Rechazar
      </button>
    </div>
  </form>
</article>