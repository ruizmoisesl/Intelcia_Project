---
import { formatShortDate } from "../lib/format";
import type { RotationEntry } from "../services/api";
import ShiftBadge from "./ShiftBadge.astro";

interface Props {
  entries: RotationEntry[];
}

const { entries } = Astro.props;
---

{entries.length > 0 && (
  <section class="bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl p-5 hover:border-rose-500/20 transition-all duration-300">
    <div class="flex items-center gap-2.5 mb-4">
      <div class="p-1.5 bg-rose-500/10 rounded-lg">
        <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
      </div>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400">
        Próximas semanas · Rotación
      </h2>
      <span class="ml-auto text-[10px] text-gray-500 bg-white/5 px-2 py-0.5 rounded-full border border-white/5">
        {entries.length} semanas
      </span>
    </div>

    <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
      {entries.map((entry) => (
        <li class="group flex items-center gap-3 bg-white/5 border border-white/5 rounded-xl px-3.5 py-2.5 hover:bg-white/10 hover:border-rose-500/20 transition-all duration-300 hover:-translate-y-0.5">
          <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-[10px] font-bold text-gray-500">
            {new Date(entry.week_start).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-[11px] text-gray-400 truncate">
              {formatShortDate(entry.week_start)}
            </p>
            <div class="mt-0.5">
              <ShiftBadge shift={entry.shift} />
            </div>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-4 pt-3 border-t border-white/5 flex items-center gap-2 text-xs text-gray-500">
      <svg class="w-3.5 h-3.5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>Tu turno rota cada semana. Una novedad aprobada puede modificarlo.</span>
    </div>
  </section>
)}