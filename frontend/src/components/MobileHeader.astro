---
import type { ApiUser } from "../services/api";
import Icon from "./Icon.astro";
import NavMenu from "./NavMenu.astro";

interface Props {
  user: ApiUser;
  currentPath: string;
}

const { user, currentPath } = Astro.props;
---

<header class="sticky top-0 z-40 lg:hidden">
  <div class="border-b transition-colors duration-300 dark:bg-[#0a0a0f]/95 dark:backdrop-blur-xl dark:border-white/5 bg-white/95 backdrop-blur-xl border-slate-200/50">
    <details class="group">
      <summary
        class="flex h-14 cursor-pointer list-none items-center justify-between px-4 [&::-webkit-details-marker]:hidden transition-colors duration-200 dark:hover:bg-white/5 hover:bg-slate-100/50"
      >
        <div class="flex items-center gap-3">
          <div
            class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-r from-rose-500 to-rose-600 shadow-lg shadow-rose-500/25"
          >
            <Icon name="building" class="h-4 w-4 text-white" />
          </div>
          <div>
            <span class="text-sm font-bold tracking-tight dark:text-white text-slate-900">
              Nexus Central
            </span>
            <span
              class="ml-1.5 text-[10px] font-medium uppercase tracking-wider text-rose-400/60"
            >
              v2.4
            </span>
          </div>
        </div>
        <div class="flex items-center gap-3">
          {/* Indicador de estado */}
          <div class="hidden sm:flex items-center gap-1.5 mr-1">
            <span
              class="inline-block w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"
            ></span>
            <span class="text-[10px] dark:text-gray-500 text-slate-400">Online</span>
          </div>
          <Icon
            name="chevronDown"
            class="h-5 w-5 transition-transform duration-300 group-open:rotate-180 dark:text-gray-400 text-slate-400"
          />
        </div>
      </summary>

      <div class="border-t px-3 pb-4 pt-3 space-y-3 dark:border-white/5 border-slate-200/50">
        {/* Menú de navegación */}
        <div class="dark:bg-white/5 bg-slate-100/50 rounded-xl p-1">
          <NavMenu currentPath={currentPath} role={user.role} />
        </div>

        {/* Perfil y acciones */}
        <div
          class="flex items-center justify-between dark:bg-white/5 bg-slate-100/50 rounded-xl px-3 py-2.5 dark:border-white/5 border-slate-200/50 border"
        >
          <div class="flex items-center gap-2.5 min-w-0">
            <div
              class="flex-shrink-0 h-8 w-8 rounded-full bg-gradient-to-r from-rose-500 to-rose-600 flex items-center justify-center text-xs font-bold text-white shadow-lg shadow-rose-500/20"
            >
              {user.name.charAt(0).toUpperCase()}
            </div>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-medium dark:text-white text-slate-900">
                {user.name}
              </p>
              <p class="truncate text-[10px] dark:text-gray-400 text-slate-500">
                {user.email}
              </p>
            </div>
          </div>
          <div class="flex items-center gap-1">
            <button
              type="button"
              onclick="portalToggleTheme()"
              title="Cambiar tema (claro/oscuro)"
              aria-label="Cambiar tema"
              class="rounded-lg p-2 transition-colors duration-200 dark:text-gray-400 dark:hover:text-white dark:hover:bg-white/10 text-slate-500 hover:text-slate-900 hover:bg-slate-100"
            >
              <Icon name="sun" class="hidden h-5 w-5 dark:block" />
              <Icon name="moon" class="h-5 w-5 dark:hidden" />
            </button>
            <a
              href="/dashboard/perfil"
              class="p-2 rounded-lg transition-all duration-200 dark:text-gray-400 dark:hover:text-white dark:hover:bg-white/10 text-slate-500 hover:text-slate-900 hover:bg-slate-100"
              aria-label="Perfil"
            >
              <Icon name="settings" class="h-4 w-4" />
            </a>
            <form method="POST" action="/api/logout" class="inline">
              <button
                type="submit"
                class="p-2 rounded-lg transition-all duration-200 dark:text-gray-400 dark:hover:text-rose-400 dark:hover:bg-rose-500/10 text-slate-500 hover:text-rose-500 hover:bg-rose-50"
                aria-label="Cerrar sesión"
              >
                <Icon name="logout" class="h-4 w-4" />
              </button>
            </form>
          </div>
        </div>

        {/* Información adicional */}
        <div class="flex items-center justify-between px-2 pt-1">
          <span class="text-[10px] dark:text-gray-500 text-slate-400">
            Cluster: US-EAST-4B
          </span>
          <span class="flex items-center gap-1.5 text-[10px] dark:text-gray-500 text-slate-400">
            <span class="inline-block w-1 h-1 bg-emerald-400 rounded-full"></span>
            Sync Activo
          </span>
        </div>
      </div>
    </details>
  </div>
</header>