---
import type { ApiUser } from "../services/api";
import Icon from "./Icon.astro";
import NavMenu from "./NavMenu.astro";

interface Props {
  user: ApiUser;
  currentPath: string;
}

const { user, currentPath } = Astro.props;
---

<header class="sticky top-0 z-40 lg:hidden">
  <div class="bg-[#0a0a0f]/95 backdrop-blur-xl border-b border-white/5">
    <details class="group">
      <summary
        class="flex h-14 cursor-pointer list-none items-center justify-between px-4 [&::-webkit-details-marker]:hidden hover:bg-white/5 transition-colors duration-200"
      >
        <div class="flex items-center gap-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-r from-rose-500 to-rose-600 shadow-lg shadow-rose-500/25">
            <Icon name="building" class="h-4 w-4 text-white" />
          </div>
          <div>
            <span class="text-sm font-bold text-white tracking-tight">Nexus Central</span>
            <span class="ml-1.5 text-[10px] font-medium text-rose-400/60 uppercase tracking-wider">v2.4</span>
          </div>
        </div>
        <div class="flex items-center gap-3">
          {/* Indicador de estado */}
          <div class="hidden sm:flex items-center gap-1.5 mr-1">
            <span class="inline-block w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></span>
            <span class="text-[10px] text-gray-500">Online</span>
          </div>
          <Icon name="chevronDown" class="h-5 w-5 text-gray-400 transition-transform duration-300 group-open:rotate-180" />
        </div>
      </summary>

      <div class="border-t border-white/5 px-3 pb-4 pt-3 space-y-3">
        {/* Menú de navegación */}
        <div class="bg-white/5 rounded-xl p-1">
          <NavMenu currentPath={currentPath} role={user.role} />
        </div>
        
        {/* Perfil y acciones */}
        <div class="flex items-center justify-between bg-white/5 rounded-xl px-3 py-2.5 border border-white/5">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="flex-shrink-0 h-8 w-8 rounded-full bg-gradient-to-r from-rose-500 to-rose-600 flex items-center justify-center text-xs font-bold text-white shadow-lg shadow-rose-500/20">
              {user.name.charAt(0).toUpperCase()}
            </div>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-medium text-white">{user.name}</p>
              <p class="truncate text-[10px] text-gray-400">{user.email}</p>
            </div>
          </div>
          <div class="flex items-center gap-1">
            <a 
              href="/dashboard/perfil" 
              class="p-2 rounded-lg text-gray-400 hover:text-white hover:bg-white/10 transition-all duration-200"
              aria-label="Perfil"
            >
              <Icon name="settings" class="h-4 w-4" />
            </a>
            <form method="POST" action="/api/logout" class="inline">
              <button
                type="submit"
                class="p-2 rounded-lg text-gray-400 hover:text-rose-400 hover:bg-rose-500/10 transition-all duration-200"
                aria-label="Cerrar sesión"
              >
                <Icon name="logout" class="h-4 w-4" />
              </button>
            </form>
          </div>
        </div>

        {/* Información adicional */}
        <div class="flex items-center justify-between px-2 pt-1">
          <span class="text-[10px] text-gray-500">Cluster: US-EAST-4B</span>
          <span class="flex items-center gap-1.5 text-[10px] text-gray-500">
            <span class="inline-block w-1 h-1 bg-emerald-400 rounded-full"></span>
            Sync Activo
          </span>
        </div>
      </div>
    </details>
  </div>
</header>