---
import { formatShortDate } from "../lib/format";
import { CUSTOM_DAY_STYLE, shiftStyle } from "../lib/shift-styles";
import type { ShiftDefinition, WeekSchedule } from "../services/api";
import Icon from "./Icon.astro";
import ShiftLegend from "./ShiftLegend.astro";

interface Props {
  week: WeekSchedule;
  shifts: ShiftDefinition[];
  today?: string | null;
}

const { week, shifts, today = null } = Astro.props;

// Solo pinta lo que la API calcula: cero lógica de turnos aquí.
const workingDays = week.days.filter((day) => day.start !== null);
const restDays = week.days.filter((day) => day.start === null);
const baseStyle = shiftStyle(week.shift.color);
const gridClass = workingDays.length > 5 ? "lg:grid-cols-6" : "lg:grid-cols-5";
---

<div class="space-y-6">
  <div class:list={["grid gap-4 sm:grid-cols-2 md:grid-cols-3", gridClass]}>
    {workingDays.map((day) => {
      const isToday = day.date === today;
      const dayStyle = day.is_custom
        ? (day.custom_shift ? shiftStyle(day.custom_shift.color) : CUSTOM_DAY_STYLE)
        : day.is_holiday
          ? shiftStyle("purple")
          : baseStyle;
      return (
        <article
          class:list={[
            "group relative bg-white/5 backdrop-blur-sm border border-white/5 rounded-2xl p-5 hover:bg-white/10 hover:border-rose-500/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-rose-500/5",
            isToday && "border-rose-500/30 ring-2 ring-rose-500/20",
            day.is_custom && "border-amber-500/30 ring-1 ring-amber-500/20",
          ]}
        >
          {/* Efecto de brillo en hover */}
          <div class="absolute inset-0 pointer-events-none bg-gradient-to-r from-transparent via-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-2xl"></div>
          
          <header class="flex items-center justify-between gap-2 relative z-10">
            <div class="flex items-center gap-2">
              <h3 class={`text-sm font-semibold ${dayStyle.time}`}>{day.day_name}</h3>
              {isToday && (
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-rose-400 animate-pulse"></span>
              )}
            </div>
            <span class="text-xs tabular-nums text-gray-500">{formatShortDate(day.date)}</span>
          </header>

          <div class="mt-2 flex flex-wrap gap-1.5">
            {day.is_holiday && (
              <span
                class={`rounded-full px-2.5 py-0.5 text-[10px] font-medium border ${dayStyle.badge}`}
                title={day.holiday_name ?? "Festivo"}
              >
                🎉 Festivo
              </span>
            )}

            {day.is_custom && (
              <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[10px] font-medium border border-amber-500/20 bg-amber-500/10 text-amber-400">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                Personalizado
              </span>
            )}

            {!day.is_holiday && !day.is_custom && (
              <span class="text-[10px] text-gray-600 bg-white/5 px-2 py-0.5 rounded-full border border-white/5">
                {week.shift.name}
              </span>
            )}
          </div>

          <div class="mt-4 relative z-10">
            <p class={`text-2xl font-bold tabular-nums ${dayStyle.time}`}>{day.start}</p>
            <div class="my-2 flex items-center gap-2">
              <span class={`h-px flex-1 opacity-20 ${dayStyle.chip}`}></span>
              <Icon name="arrowDown" class="h-3.5 w-3.5 text-gray-600" />
              <span class={`h-px flex-1 opacity-20 ${dayStyle.chip}`}></span>
            </div>
            <p class={`text-2xl font-bold tabular-nums ${dayStyle.time}`}>{day.end}</p>
          </div>

          <footer class="mt-4 pt-3 border-t border-white/5 flex items-center justify-between gap-2 relative z-10">
            <div class="flex items-center gap-2 flex-1 min-w-0">
              {day.holiday_name && (
                <span class="truncate text-[11px] text-gray-500" title={day.holiday_name}>
                  {day.holiday_name}
                </span>
              )}
              {day.is_custom && day.custom_shift && (
                <span class="truncate text-[10px] text-amber-400/60" title="Horario personalizado">
                  ⚡ {day.custom_shift.name}
                </span>
              )}
              {day.source && !day.is_custom && !day.is_holiday && (
                <span class="text-[9px] text-gray-600 font-mono bg-white/5 px-1.5 py-0.5 rounded border border-white/5">
                  {day.source}
                </span>
              )}
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              {isToday && (
                <span class="rounded-full bg-gradient-to-r from-rose-500 to-rose-600 px-2.5 py-0.5 text-[10px] font-medium text-white shadow-lg shadow-rose-500/25">
                  Hoy
                </span>
              )}
              {day.is_custom && (
                <span class="text-[10px] text-amber-400/40" title="Día personalizado">✏️</span>
              )}
            </div>
          </footer>
        </article>
      );
    })}
  </div>

  {restDays.length > 0 && (
    <div class="bg-white/5 border border-dashed border-white/10 rounded-xl px-4 py-3 text-sm text-gray-400 flex items-start gap-3 hover:border-rose-500/20 transition-all duration-300">
      <div class="flex-shrink-0 mt-0.5">
        <Icon name="coffee" class="h-4 w-4 text-gray-500" />
      </div>
      <span>
        {restDays.map((day) =>
          day.is_holiday
            ? `${day.day_name} — festivo${day.holiday_name ? ` (${day.holiday_name})` : ""}`
            : day.day_name,
        ).join(" · ")}: descanso (sin turno asignado).
      </span>
    </div>
  )}

  <ShiftLegend shifts={shifts} />
  
  <div class="flex flex-wrap items-center gap-4 text-xs bg-white/5 border border-white/5 rounded-xl px-4 py-3">
    <span class="text-gray-400 font-medium">Tipos de día:</span>
    <span class="flex items-center gap-1.5 text-gray-400">
      <span class="inline-block w-2 h-2 rounded-full bg-amber-400/70"></span>
      Personalizado
    </span>
    <span class="text-gray-600">|</span>
    <span class="flex items-center gap-1.5 text-gray-400">
      <span class="inline-block w-2 h-2 rounded-full bg-purple-400/70"></span>
      Festivo
    </span>
    <span class="text-gray-600">|</span>
    <span class="flex items-center gap-1.5 text-gray-400">
      <span class="inline-block w-2 h-2 rounded-full bg-rose-400/70"></span>
      Turno regular
    </span>
    <span class="ml-auto text-[10px] text-gray-500 bg-white/5 px-2 py-0.5 rounded-full border border-white/5">
      Los días personalizados tienen un horario especial asignado por supervisión
    </span>
  </div>
</div>