# Copia este archivo como .env y ajusta los valores.

# Genera una clave segura con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-generada-con-secrets-token-hex-32

ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite en desarrollo. Para producción, p. ej.:
#   postgresql+psycopg://usuario:password@localhost:5432/portal
DATABASE_URL=sqlite:///./portal.db

ALLOWED_ORIGINS=["http://localhost:4321"]
DEBUG=true

# --- Festivos: Google Calendar API ---
# Clave de API de un proyecto de Google Cloud con la «Calendar API» habilitada.
# Sin clave (o si Google falla) se usa el cálculo local de festivos de Colombia.
GOOGLE_CALENDAR_API_KEY=AIzaSyAcvijvI1QddTqqSnsOKToorbrsEG1m0So
GOOGLE_CALENDAR_ID=es.colombian#holiday@group.v.calendar.google.com
# auto = Google con fallback local | google | local
HOLIDAYS_PROVIDER=auto
HOLIDAYS_CACHE_TTL_HOURS=24

# ── Base de datos ──────────────────────────────────────────────
# MySQL (recomendado; también usado en docker-compose):
#   - El driver es PyMySQL (mysql+pymysql://).
#   - charset=utf8mb4 es obligatorio (no uses "utf8": son 3 bytes).
#   - Si la contraseña tiene caracteres especiales (: / @ ?), codifígalos
#     (URL-encode), p. ej. ":" → "%3A".
DATABASE_URL=mysql+pymysql://portal:portalpass-dev@localhost:3306/portal?charset=utf8mb4

# SQLite (desarrollo rápido sin MySQL instalado):
# DATABASE_URL=sqlite:///./portal.db

# Zona horaria del negocio para calcular «hoy» (horarios, novedades, auditoría).
BUSINESS_TIMEZONE=America/Bogota

BUSINESS_TIMEZONE=America/Bogota

# --- Envío de tareas (opcional; sin configurar, el portal funciona igual) ---
# Jira Cloud: https://tuempresa.atlassian.net · token en Atlassian → Cuenta → Seguridad
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
