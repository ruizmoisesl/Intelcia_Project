# --- Tickets (mesón de soporte: proyecto de LECTURA en Jira) ---
JIRA_TICKETS_PROJECT=IT
TICKETS_CACHE_TTL_SECONDS=60
TICKETS_MAX_RESULTS=500

# --- Ámbito del mesón: SOLO esta sede/grupo (empresa global) ---
# Cómo encontrar el nombre exacto del grupo:
#   curl "http://localhost:8000/api/v1/tickets/groups?query=Colombia" -H "Authorization: Bearer <T_ADMIN>"
#   (o Jira → Administración → Grupos). Tres modos, gana el primero configurado:

# A) Fragmento JQL crudo (máxima flexibilidad):
# JIRA_TICKETS_EXTRA_JQL=component = "Workstation"

# B) Campo personalizado («campos anclados» de Jira): cf[id] = "valor"
# JIRA_TICKETS_FIELD_ID=10100
# JIRA_TICKETS_FIELD_VALUE=IT-Colombia-Workstation & Computer

# C) Grupo de Jira (assignee in membersOf) + cola sin asignar:
JIRA_TICKETS_GROUP=IT-Colombia-Workstation & Computer
JIRA_TICKETS_INCLUDE_UNASSIGNED=true

# --- KPIs ---
# Riesgo SLA (JSM). Ejemplo: a menos de 2 h de vencer y no vencidos:
# JIRA_TICKETS_SLA_RISK_JQL="Time to resolution" < remaining("2h")
JIRA_TICKETS_MTTR_WINDOW_DAYS=30
# Campo de satisfacción (CSAT) en issues resueltos; vacío = tarjeta oculta:
# JIRA_TICKETS_CSAT_FIELD=customfield_10041
TICKETS_STATS_CACHE_TTL_SECONDS=300